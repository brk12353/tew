			end)
			box.FocusLost:Connect(function()
				Tween(stroke, { Color = Theme.Line }, Motion.Fast)
				Tween(box, { TextColor3 = Theme.TextDim }, Motion.Fast)
			end)
			return box
		end
		local hexBox = inputBox(2, 1)
		local rgbBox = inputBox(3, 1.3)

		local function render(instant)
			local color = Color3.fromHSV(hue, saturation, brightness)
			picker.Value = color
			field.BackgroundColor3 = Color3.fromHSV(hue, 1, 1)
			local duration = instant and 0 or 0.06
			Tween(fieldCursor, { Position = UDim2.fromScale(saturation, 1 - brightness) }, duration)
			Tween(hueCursor, { Position = UDim2.fromScale(hue, 0.5) }, duration)
			Tween(swatch, { BackgroundColor3 = color }, instant and 0 or Motion.Fast)
			preview.BackgroundColor3 = color
			if not hexBox:IsFocused() then
				hexBox.Text = "#" .. string.upper(color:ToHex())
			end
			if not rgbBox:IsFocused() then
				rgbBox.Text = string.format(
					"%d, %d, %d",
					math.floor(color.R * 255 + 0.5),
					math.floor(color.G * 255 + 0.5),
					math.floor(color.B * 255 + 0.5)
				)
			end
		end

		local function commit(silent)
			render(false)
			picker.BaseValue = picker.Value
			SetFlag(picker)
			if not silent and picker.Mode == "Static" then
				SafeCall(picker.Callback, picker.Value)
			end
		end

		picker.Mode = "Static"
		picker.Speed = tonumber(options.Speed) or 1
		picker.LastFired = 0
		function picker:_Animate(clock)
			local speed = self.Speed
			local color
			if self.Mode == "Rainbow" then
				color = Color3.fromHSV((hue + clock * 0.12 * speed) % 1, math.max(saturation, 0.35), math.max(brightness, 0.35))
			elseif self.Mode == "Chroma" then
				local wave = 0.5 + 0.5 * math.sin(clock * math.pi * 0.8 * speed)
				local eased = wave * wave * (3 - 2 * wave)
				color = Color3.new(eased, eased, eased)
			elseif self.Mode == "Pulse" then
				local wave = 0.5 + 0.5 * math.sin(clock * math.pi * speed)
				color = Color3.fromHSV(hue, saturation, brightness * (0.35 + 0.65 * wave))
			else
				return
			end
			self.Value = color
			swatch.BackgroundColor3 = color
			preview.BackgroundColor3 = color
			if clock - self.LastFired >= 1 / 30 then
				self.LastFired = clock
				SafeCall(self.Callback, color)
			end
		end

		local extras = NewSection({ Frame = popover.Content, Name = tostring(name), Nested = true })
		extras.Order = 10
		local speedSlider = nil
		local modeDropdown = nil
		local function renderModes()
			if modeDropdown and modeDropdown.Value ~= picker.Mode then
				modeDropdown:Set(picker.Mode, true)
			end
		end

		function picker:SetMode(mode)
			if mode ~= "Static" and mode ~= "Rainbow" and mode ~= "Pulse" and mode ~= "Chroma" then
				return
			end
			self.Mode = mode
			renderModes()
			if mode == "Static" then
				Library.AnimatedPickers[self] = nil
				self.Value = Color3.fromHSV(hue, saturation, brightness)
				render(false)
				SafeCall(self.Callback, self.Value)
			else
				Library.AnimatedPickers[self] = true
			end
		end

		function picker:SetSpeed(speed)
			self.Speed = math.clamp(tonumber(speed) or 1, 0.1, 5)
			if speedSlider and speedSlider.Value ~= self.Speed then
				speedSlider:Set(self.Speed, true)
			end
		end

		task.defer(function()
			modeDropdown = extras:AddDropdown({
				Name = "Mode",
				Options = { "Static", "Rainbow", "Pulse", "Chroma" },
				Default = picker.Mode,
				Callback = function(mode)
					if mode then
						picker:SetMode(mode)
					end
				end,
			})
			speedSlider = extras:AddSlider({
				Name = "Animation speed",
				Min = 0.1,
				Max = 5,
				Increment = 0.1,
				Default = picker.Speed,
				Suffix = "x",
				Callback = function(value)
					picker.Speed = value
				end,
			})
		end)

		local draggingField = false
		local draggingHue = false
		local function updateField(position)
			local size = field.AbsoluteSize
			if size.X <= 0 or size.Y <= 0 then
				return
			end
			saturation = math.clamp((position.X - field.AbsolutePosition.X) / size.X, 0, 1)
			brightness = 1 - math.clamp((position.Y - field.AbsolutePosition.Y) / size.Y, 0, 1)
			commit()
		end
		local function updateHue(position)
			local size = hueBar.AbsoluteSize
			if size.X <= 0 then
				return
			end
			hue = math.clamp((position.X - hueBar.AbsolutePosition.X) / size.X, 0, 1)
			commit()
		end
		local fieldGrab = {}
		local hueGrab = {}
		local function stopPicking()
			draggingField = false
			draggingHue = false
			EndGrab(fieldGrab)
			EndGrab(hueGrab)
		end
		field.InputBegan:Connect(function(input)
			if IsPrimary(input) and not draggingField and not draggingHue and BeginGrab(fieldGrab, field, stopPicking) then
				draggingField = true
				updateField(input.Position)
			end
		end)
		hueBar.InputBegan:Connect(function(input)
			if IsPrimary(input) and not draggingField and not draggingHue and BeginGrab(hueGrab, hueBar, stopPicking) then
				draggingHue = true
				updateHue(input.Position)
			end
		end)
		Connect(UserInputService.InputChanged, function(input)
			if IsMove(input) then
				if draggingField then
					updateField(input.Position)
				elseif draggingHue then
					updateHue(input.Position)
				end
			end
		end)
		Connect(UserInputService.InputEnded, function(input)
			if IsPrimary(input) and (draggingField or draggingHue) then
				stopPicking()
			end
		end)
		hexBox.FocusLost:Connect(function()
			local cleaned = string.gsub(hexBox.Text, "[^%x]", "")
			local ok, color = pcall(Color3.fromHex, cleaned)
			if ok and #cleaned == 6 then
				hue, saturation, brightness = color:ToHSV()
				commit()
			else
				render(true)
			end
		end)
		rgbBox.FocusLost:Connect(function()
			local r, g, b = string.match(rgbBox.Text, "(%d+)%D+(%d+)%D+(%d+)")
			if r and g and b then
				local color = Color3.fromRGB(
					math.clamp(tonumber(r) or 0, 0, 255),
					math.clamp(tonumber(g) or 0, 0, 255),
					math.clamp(tonumber(b) or 0, 0, 255)
				)
				hue, saturation, brightness = color:ToHSV()
				commit()
			else
				render(true)
			end
		end)

		popover.OnOpen = function()
			Tween(swatchStroke, { Color = Theme.Accent }, Motion.Fast)
		end
		popover.OnClose = function()
			Tween(swatchStroke, { Color = Theme.LineStrong }, Motion.Fast)
		end
		swatch.Activated:Connect(function()
			Library:_OpenPopover(popover, swatch)
		end)

		function picker:Set(color, silent)
			if typeof(color) ~= "Color3" then
				return
			end
			hue, saturation, brightness = color:ToHSV()
			commit(silent)
		end

		function picker:Get()
			return self.Value
		end

		picker.Swatch = swatch
		picker.Popover = popover
		render(true)
		picker.BaseValue = picker.Value
		if type(options.Mode) == "string" and options.Mode ~= "Static" then
			picker:SetMode(options.Mode)
		end
		return picker
	end

	local ToggleMethods = {}
	ToggleMethods.__index = ToggleMethods

	function ToggleMethods:IsLive()
		return self.Section == nil or self.Section:IsLive()
	end

	function ToggleMethods:IsActive()
		return self.Value == true and self:IsLive()
	end

	function ToggleMethods:_Emit()
		local effective = self:IsActive()
		if effective ~= self.LastEmitted then
			self.LastEmitted = effective
			SafeCall(self.Callback, effective)
		end
	end

	function ToggleMethods:Set(value, silent)
		self.Value = value == true
		SetFlag(self)
		self._Render(false)
		if silent then
			self.LastEmitted = self:IsActive()
		else
			self:_Emit()
		end
		if self.OnChanged then
			self.OnChanged(self.Value)
		end
		if self.Watchers then
			for _, watcher in ipairs(self.Watchers) do
				SafeCall(watcher, self.Value)
			end
		end
		Library:_RefreshKeybindList()
	end

	function ToggleMethods:Get()
		return self.Value
	end

	function ToggleMethods:AddKeybind(options)
		options = options or {}
		if not options.Name then
			options.Name = self.Name
		end
		local target = not options.Detached and self or nil
		local keybind = BuildKeybind(self.Accessories, 30, options, target, self.Section)
		RegisterElement(keybind)
		self.Keybind = keybind
		return keybind
	end

	function ToggleMethods:AddColorPicker(options)
		options = options or {}
		local picker = BuildColorPicker(self.Accessories, 20, options, tostring(options.Name or self.Name))
		RegisterElement(picker)
		return picker
	end

