			Create("UIFlexItem", { FlexMode = Enum.UIFlexMode.Shrink, Parent = buttonLabel })
			holder.MouseEnter:Connect(function()
				Tween(holder, { BackgroundColor3 = Theme.Hover }, Motion.Fast)
				Tween(stroke, { Color = Theme.LineStrong }, Motion.Fast)
