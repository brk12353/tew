	local PressPlayers = setmetatable({}, { __mode = "k" })
	local function PressScale(button)
		if button:GetAttribute("AscendShine") then
			return PressPlayers[button]
		end
		button:SetAttribute("AscendShine", true)

		local hoverPlaying = false
		local function playHover()
			if hoverPlaying or PointerBlocked(button) then
				return
			end
			local gui = button:FindFirstAncestorOfClass("ScreenGui")
			if not gui or button.AbsoluteSize.X <= 0 then
				return
			end
			hoverPlaying = true
			local clip = Create("Frame", {
				Name = "HoverSweep",
				BackgroundTransparency = 1,
				ClipsDescendants = true,
				ZIndex = 1000,
			})
			clip:SetAttribute("AscendFixed", true)
			local sheen = Create("Frame", {
				BackgroundColor3 = Color3.new(1, 1, 1),
				ZIndex = 1000,
				Parent = clip,
			})
			local corner = button:FindFirstChildOfClass("UICorner")
			if corner then
				local scale = marqueeScale(button)
				Create("UICorner", { CornerRadius = UDim.new(corner.CornerRadius.Scale, corner.CornerRadius.Offset * scale), Parent = sheen })
			end
			local gradient = Create("UIGradient", {
				Rotation = 20,
				Color = SweepColor,
				Transparency = SweepFade,
				Offset = Vector2.new(-1, 0),
				Parent = sheen,
			})
			local function follow()
				local origin = gui.AbsolutePosition
				local minX, minY, maxX, maxY = SweepBounds(button)
				clip.Visible = maxX > minX and maxY > minY and button.Visible
				clip.Position = UDim2.fromOffset(minX - origin.X, minY - origin.Y)
				clip.Size = UDim2.fromOffset(math.max(maxX - minX, 0), math.max(maxY - minY, 0))
				local position = button.AbsolutePosition
				local size = button.AbsoluteSize
				sheen.Position = UDim2.fromOffset(position.X - minX, position.Y - minY)
				sheen.Size = UDim2.fromOffset(size.X, size.Y)
			end
			follow()
			clip.Parent = gui
			local connection = RunService.Heartbeat:Connect(follow)
			local tween = TweenService:Create(gradient, TweenInfo.new(0.7, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Offset = Vector2.new(1, 0) })
			tween:Play()
			tween.Completed:Connect(function()
				connection:Disconnect()
				clip:Destroy()
				hoverPlaying = false
			end)
		end

		local clickToken = 0
		local active = {}
		local function bandSequence(half)
			local reach = math.min(half, 0.49)
			local points = { ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)) }
			for step = -4, 4 do
				local spread = step / 4
				local shade = 1 - 0.96 * math.exp(-(spread * 2.1) ^ 2)
				local value = math.clamp(shade, 0.03, 1)
				table.insert(points, ColorSequenceKeypoint.new(0.5 + spread * reach, Color3.new(value, value, value * 1.02 > 1 and 1 or value * 1.02)))
			end
			table.insert(points, ColorSequenceKeypoint.new(1, Color3.new(1, 1, 1)))
			return ColorSequence.new(points)
		end
		local function playClick()
			clickToken += 1
			local mine = clickToken
			local left = button.AbsolutePosition.X
			local span = math.max(button.AbsoluteSize.X, 1)
			local band = math.clamp(span * 0.2, 34, 84)
			local entries = {}
			for _, object in ipairs(ShineTargets(button)) do
				local width = object.AbsoluteSize.X
				if width > 0 then
					local gradient = object:FindFirstChild("ClickShine")
					if not gradient then
						gradient = Instance.new("UIGradient")
						gradient.Name = "ClickShine"
						gradient.Enabled = false
						gradient:SetAttribute("AscendFixed", true)
						gradient.Parent = object
					end
					gradient.Rotation = 0
					gradient.Color = bandSequence(band / width)
					gradient.Offset = Vector2.new(-1, 0)
					gradient.Enabled = true
					active[gradient] = true
					table.insert(entries, { Gradient = gradient, Left = object.AbsolutePosition.X, Width = width })
				end
			end
			if #entries == 0 then
				return
			end
			local progress = Instance.new("NumberValue")
			local function place()
				if mine ~= clickToken then
					return
				end
				local center = left - band * 1.2 + progress.Value * (span + band * 2.4)
				for _, entry in ipairs(entries) do
					entry.Gradient.Offset = Vector2.new((center - entry.Left) / entry.Width - 0.5, 0)
				end
			end
			place()
			progress.Changed:Connect(place)
			local duration = math.clamp(0.8 + span / 600, 0.95, 1.4)
			local tween = TweenService:Create(progress, TweenInfo.new(duration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut), { Value = 1 })
			tween:Play()
			tween.Completed:Connect(function()
				progress:Destroy()
				if mine ~= clickToken then
					return
				end
				for gradient in pairs(active) do
					gradient.Enabled = false
				end
				table.clear(active)
			end)
		end

		button.InputBegan:Connect(function(input)
			if IsPrimary(input) and not button:GetAttribute("AscendSwitchOnly") then
				playClick()
			end
		end)
		button.MouseEnter:Connect(playHover)
		PressPlayers[button] = playClick
		return playClick
	end

	local function ResolveParent()
		local hidden = nil
		pcall(function()
			if typeof(gethui) == "function" then
				hidden = gethui()
			end
		end)
		if typeof(hidden) == "Instance" then
			return hidden
		end
		local coreGui = nil
		pcall(function()
			local CoreGui = Services.CoreGui
			local probe = Instance.new("Folder")
			probe.Parent = CoreGui
			probe:Destroy()
			coreGui = CoreGui
		end)
		if coreGui then
			return coreGui
		end
		return LocalPlayer:WaitForChild("PlayerGui")
	end

