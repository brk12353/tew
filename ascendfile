		end
		state.Token += 1
		local token = state.Token
		state.Active = true
		local pad = label:FindFirstChildOfClass("UIPadding")
		if not pad then
			pad = Create("UIPadding", { Parent = label })
		end
		state.Pad = pad
		state.PadLeft = pad.PaddingLeft
		state.Truncate = label.TextTruncate
		state.Alignment = label.TextXAlignment
		state.Clips = label.ClipsDescendants
		task.spawn(function()
			local textWidth = marqueeTextWidth(label)
			if state.Token ~= token then
				return
			end
			if not textWidth then
				stopMarquee(label, state)
				return
			end
			label.ClipsDescendants = true
			label.TextTruncate = Enum.TextTruncate.None
			label.TextXAlignment = Enum.TextXAlignment.Left
			local baseLeft = state.PadLeft.Offset
			task.wait(0.4)
			if state.Token == token and label.Parent and not Library.Unloaded then
				local width = label.AbsoluteSize.X / marqueeScale(label)
				local room = width - baseLeft - pad.PaddingRight.Offset
				local overflow = math.ceil(textWidth - room) + 2
				if overflow > 2 then
					local duration = math.clamp(overflow / MarqueeSpeed, 0.6, 9)
					local legs = { { baseLeft, baseLeft - overflow }, { baseLeft - overflow, baseLeft } }
					for _, leg in ipairs(legs) do
						if state.Token ~= token then
							break
						end
						pad.PaddingLeft = UDim.new(0, leg[1])
						local tween = slidePadding(pad, leg[2], duration)
						state.Tween = tween
						local finished = tween.PlaybackState == Enum.PlaybackState.Completed
						if not finished then
							tween.Completed:Wait()
						end
						if state.Token ~= token then
							break
						end
						pad.PaddingLeft = UDim.new(0, leg[2])
						task.wait(0.8)
					end
				end
			end
			if state.Token == token then
				stopMarquee(label, state)
			end
		end)
	end

	local function Marquee(label)
		if MarqueeState[label] or label.RichText then
			return label
		end
		local state = { Token = 0, Active = false, Hovered = false, Touch = false, Zone = label }
		MarqueeState[label] = state
		label:GetPropertyChangedSignal("Text"):Connect(function()
			if not state.Active then
				return
			end
			stopMarquee(label, state)
			task.defer(function()
				if state.Hovered then
					runMarquee(label, state)
				end
			end)
		end)
		local zone = label.Parent
		if not (zone and zone:IsA("GuiObject")) then
			zone = label
		end
		state.Zone = zone
		zone.MouseEnter:Connect(function()
			state.Hovered = true
			state.Touch = false
			task.defer(function()
				if state.Hovered then
					runMarquee(label, state)
				end
			end)
		end)
		zone.MouseLeave:Connect(function()
			task.defer(function()
				if state.Touch or pointerInside(zone) then
					return
				end
				state.Hovered = false
				stopMarquee(label, state)
			end)
		end)
		zone.InputBegan:Connect(function(input)
			if input.UserInputType ~= Enum.UserInputType.Touch or state.Active then
				return
			end
			state.Touch = true
			runMarquee(label, state)
			local token = state.Token
			task.delay(8, function()
				if state.Token == token and state.Touch then
					state.Touch = false
					stopMarquee(label, state)
				end
			end)
		end)
		return label
	end

	local function Text(properties)
		local base = {
			BackgroundTransparency = 1,
			FontFace = Fonts.Medium,
			TextColor3 = Theme.Text,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left,
			TextYAlignment = Enum.TextYAlignment.Center,
			Text = "",
		}
		for key, value in pairs(properties) do
			base[key] = value
		end
		local label = Create("TextLabel", base)
		if base.TextTruncate == Enum.TextTruncate.AtEnd and not base.RichText then
			Marquee(label)
		end
		return label
	end

