	function Window:_ApplySearch(query)
		local tab = self.ActiveTab
		if not tab then
			return
		end
		query = string.lower(query or "")
		for _, section in ipairs(tab.Sections) do
			local sectionMatch = query ~= "" and string.find(string.lower(section.Name), query, 1, true) ~= nil
			local anyVisible = false
			for _, entry in ipairs(section.Elements) do
				local visible = query == "" or sectionMatch or string.find(string.lower(entry.Name), query, 1, true) ~= nil
				entry.Holder.Visible = visible
				if visible then
					anyVisible = true
				end
			end
			section.Container.Visible = query == "" or sectionMatch or anyVisible
		end
	end

	function Window:SelectTab(target)
		local tab = target
		if type(target) == "string" then
			for _, candidate in ipairs(self.Tabs) do
				if candidate.Name == target then
					tab = candidate
					break
				end
			end
		end
		if type(tab) ~= "table" or self.ActiveTab == tab then
			return
		end
		Library:_CloseAllPopovers()
		local previous = self.ActiveTab
		if previous then
			previous:_SetActive(false)
			previous.Page.Visible = false
			for _, section in ipairs(previous.Sections) do
				section.Container.Visible = true
				for _, entry in ipairs(section.Elements) do
					entry.Holder.Visible = true
				end
			end
		end
		self.ActiveTab = tab
		tab:_SetActive(true)
		for _, category in ipairs(self.Categories or {}) do
			if category.Collapsed then
				self:_RefreshCategory(category)
			end
		end
		tab.Page.Position = UDim2.fromOffset(0, 10)
		tab.Page.CanvasPosition = Vector2.zero
		tab.Page.Visible = true
		Tween(tab.Page, { Position = UDim2.fromOffset(0, 0) }, Motion.Slow)
		self.TabTitle.Text = tab.Name
		self.TabTitle.TextTransparency = 1
		Tween(self.TabTitle, { TextTransparency = 0 }, Motion.Base)
		self.TabDescription.Text = tab.Description or ""
		self.TabDescription.Visible = tab.Description ~= nil and tab.Description ~= ""
		if tab.IconResolved then
			ApplyIcon(self.TabBadgeIcon, tab.IconResolved)
			self.TabBadge.Visible = true
		else
			self.TabBadge.Visible = false
		end
		if self.SearchBox.Text ~= "" then
			self.SearchBox.Text = ""
		else
			self:_ApplySearch("")
		end
	end

