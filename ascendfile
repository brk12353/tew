		self.KeybindEmpty.Visible = shownCount == 0
		if self.KeybindCount then
			if shownCount == 0 then
				self.KeybindCount.Text = ""
			elseif activeCount == 0 then
				self.KeybindCount.Text = tostring(shownCount) .. (shownCount == 1 and " bind" or " binds")
			else
				self.KeybindCount.Text = tostring(shownCount) .. (shownCount == 1 and " bind, " or " binds, ") .. tostring(activeCount) .. " on"
			end
		end
	end

	local ReservedColors = {
		["ffffff"] = true,
		["000000"] = true,
	}

	local function UniqueThemeColor(color, taken)
		local r = math.floor(color.R * 255 + 0.5)
		local g = math.floor(color.G * 255 + 0.5)
		local b = math.floor(color.B * 255 + 0.5)
		local candidate = Color3.fromRGB(r, g, b)
		local step = b >= 128 and -1 or 1
		local attempts = 0
		while (ReservedColors[string.lower(candidate:ToHex())] or taken[string.lower(candidate:ToHex())]) and attempts < 64 do
			b = math.clamp(b + step, 0, 255)
			if b == 0 or b == 255 then
				step = -step
			end
			candidate = Color3.fromRGB(r, g, b)
			attempts += 1
		end
		return candidate
	end

	function Library:ApplyTheme(changes)
		ReservedColors[string.lower(Theme.OnAccent:ToHex())] = true
		ReservedColors[string.lower(Theme.KnobOff:ToHex())] = true
		local map = {}
		local changed = false
		local taken = {}
		for _, entry in ipairs(ThemeKeys) do
			if typeof(changes[entry.Key]) ~= "Color3" then
				taken[string.lower(Theme[entry.Key]:ToHex())] = true
			end
		end
		for _, entry in ipairs(ThemeKeys) do
			local requested = changes[entry.Key]
			if typeof(requested) == "Color3" then
				local color = UniqueThemeColor(requested, taken)
				taken[string.lower(color:ToHex())] = true
				local oldHex = string.lower(Theme[entry.Key]:ToHex())
				if oldHex ~= string.lower(color:ToHex()) then
					if not ReservedColors[oldHex] then
						map[oldHex] = color
					end
					Theme[entry.Key] = color
					changed = true
				end
			end
		end
		local accent = Theme.Accent
		local light = 0.2126 * accent.R + 0.7152 * accent.G + 0.0722 * accent.B > 0.62
		local ink = Color3.new(1, 1, 1)
		if light then
			local takenNow = {}
			for _, entry in ipairs(ThemeKeys) do
				takenNow[string.lower(Theme[entry.Key]:ToHex())] = true
			end
			local oldInk = string.lower(Theme.OnAccent:ToHex())
			if oldInk ~= "ffffff" and not takenNow[oldInk] then
				ink = Theme.OnAccent
			else
				ink = UniqueThemeColor(Color3.fromRGB(12, 12, 14), takenNow)
			end
		end
		local oldInkHex = string.lower(Theme.OnAccent:ToHex())
		if oldInkHex ~= string.lower(ink:ToHex()) then
			if oldInkHex ~= "ffffff" and oldInkHex ~= "000000" then
				ReservedColors[oldInkHex] = nil
			end
			Theme.OnAccent = ink
			ReservedColors[string.lower(ink:ToHex())] = true
			changed = true
		end
		if not changed then
			return
		end
		self.ThemeHexes = nil
		if next(map) ~= nil then
			if self.ThemeSession then
				for fromHex, color in pairs(self.ThemeSession) do
					local replacement = map[string.lower(color:ToHex())]
					if replacement then
						self.ThemeSession[fromHex] = replacement
					end
				end
				for fromHex, color in pairs(map) do
					self.ThemeSession[fromHex] = color
				end
			end
			if self.ThemeIndex and not self.ThemeIndexDirty then
				local index = self.ThemeIndex
				local work = {}
				for oldHex, replacement in pairs(map) do
					local list = index[oldHex]
					if list then
						index[oldHex] = nil
						local live = {}
						for _, binding in ipairs(list) do
							local object, property = binding[1], binding[2]
							if object.Parent and string.lower(object[property]:ToHex()) == oldHex then
								table.insert(live, binding)
							end
						end
						table.insert(work, { replacement, live })
					end
				end
				for _, job in ipairs(work) do
					local replacement, live = job[1], job[2]
					local newHex = string.lower(replacement:ToHex())
					local moved = index[newHex]
					if not moved then
						moved = {}
						index[newHex] = moved
					end
					for _, binding in ipairs(live) do
						binding[1][binding[2]] = replacement
						table.insert(moved, binding)
					end
				end
				if not self.ThemeFastPass then
					local settleMap = table.clone(map)
					task.delay(0.25, function()
						if not self.Unloaded then
							self:_ThemeScan(settleMap, true)
						end
					end)
				end
			else
				self:_ThemeScan(map)
			end
		end
		self.ThemeHexes = nil
		self.ThemeApplied = (self.ThemeApplied or 0) + 1
		self:_RunThemeHooks()
	end

	local PropsGui = { "BackgroundColor3" }
	local PropsText = { "BackgroundColor3", "TextColor3" }
	local PropsBox = { "BackgroundColor3", "TextColor3", "PlaceholderColor3" }
	local PropsImage = { "BackgroundColor3", "ImageColor3" }
	local PropsScroll = { "BackgroundColor3", "ScrollBarImageColor3" }
	local PropsStroke = { "Color" }

	local function ThemeProps(object)
		if object:IsA("GuiObject") then
			if object:IsA("TextLabel") or object:IsA("TextButton") then
				return PropsText
			elseif object:IsA("TextBox") then
				return PropsBox
			elseif object:IsA("ImageLabel") or object:IsA("ImageButton") then
				return PropsImage
			elseif object:IsA("ScrollingFrame") then
				return PropsScroll
			end
			return PropsGui
		elseif object:IsA("UIStroke") then
			return PropsStroke
		end
		return nil
	end

	local function HexOf(color)
		return string.lower(color:ToHex())
	end

	function Library:_ThemeHexSet()
		local set = self.ThemeHexes
		if not set then
			set = {}
			for _, entry in ipairs(ThemeKeys) do
				set[HexOf(Theme[entry.Key])] = true
			end
			self.ThemeHexes = set
		end
		return set
	end

	local function IndexObject(index, themeHexes, object, map)
		local props = ThemeProps(object)
		if not props then
			return
		end
		for _, property in ipairs(props) do
			local hex = HexOf(object[property])
			local replacement = map and map[hex]
			if replacement then
				object[property] = replacement
				hex = HexOf(replacement)
			end
			if themeHexes[hex] then
				local list = index[hex]
				if not list then
					list = {}
					index[hex] = list
				end
				table.insert(list, { object, property })
			end
		end
	end

	local function UnderFixed(object, root)
		local current = object
		while current and current ~= root do
			if current:GetAttribute("AscendFixed") then
				return true
			end
			current = current.Parent
		end
		return false
	end

	function Library:_ThemeTrack(object)
		if self.ThemeScanAdded then
			table.insert(self.ThemeScanAdded, object)
		end
		local index = self.ThemeIndex
		if not index or self.ThemeIndexDirty then
			return
		end
		if UnderFixed(object, self.ScreenGui) then
			return
		end
		IndexObject(index, self:_ThemeHexSet(), object, nil)
		self.ThemeTracked = (self.ThemeTracked or 0) + 1
		if self.ThemeTracked > 4000 and not self.ThemeScanAdded then
			self.ThemeTracked = 0
			task.defer(function()
				if not self.ThemeScanAdded and not self.Unloaded then
					self:_ThemeScan({}, true)
				end
			end)
		end
	end

	function Library:_ThemeScan(map, sliced)
		if not self.ScreenGui then
			return
		end
		local token = (self.ThemeScanToken or 0) + 1
		self.ThemeScanToken = token
		map = map or {}
		local carry = self.ThemeScanCarry
		if carry then
			local merged = {}
			for fromHex, color in pairs(carry) do
				merged[fromHex] = map[HexOf(color)] or color
			end
			for fromHex, color in pairs(map) do
				merged[fromHex] = color
			end
			map = merged
		end
		self.ThemeScanCarry = sliced and map or nil
		self.ThemeScanAdded = sliced and {} or nil
		local appliedAtStart = self.ThemeApplied or 0
		local themeHexes = self:_ThemeHexSet()
		local root = self.ScreenGui
		local index = {}
		local stack = root:GetChildren()
		local started = os.clock()
		while #stack > 0 do
			local object = table.remove(stack)
			if not object:GetAttribute("AscendFixed") then
				IndexObject(index, themeHexes, object, map)
				for _, child in ipairs(object:GetChildren()) do
					table.insert(stack, child)
				end
			end
			if sliced and os.clock() - started > 0.002 then
				task.wait()
				if self.ThemeScanToken ~= token or self.Unloaded or not root.Parent then
					return
				end
				started = os.clock()
			end
		end
		if sliced then
			local added = self.ThemeScanAdded or {}
			self.ThemeScanAdded = nil
			if (self.ThemeApplied or 0) ~= appliedAtStart then
				return
			end
			self.ThemeScanCarry = nil
			for _, object in ipairs(added) do
				if object.Parent and object:IsDescendantOf(root) and not UnderFixed(object, root) then
					IndexObject(index, themeHexes, object, map)
				end
			end
		end
		self.ThemeIndex = index
		self.ThemeIndexDirty = false
		self.ThemeTracked = 0
	end

	function Library:_RunThemeHooks()
		self.ThemeHooksPending = true
		if self.ThemeHooksRunning then
			return
		end
		self.ThemeHooksRunning = true
		task.spawn(function()
			while self.ThemeHooksPending and not self.Unloaded do
				self.ThemeHooksPending = false
				local started = os.clock()
				local position = 1
				while position <= #self.ThemeHooks do
					pcall(self.ThemeHooks[position])
					position += 1
					if os.clock() - started > 0.003 then
						task.wait()
						started = os.clock()
					end
				end
			end
			self.ThemeHooksRunning = false
		end)
	end

	function Library:SetThemeColor(key, color)
		if typeof(color) ~= "Color3" then
			return
		end
		self.PendingTheme = self.PendingTheme or {}
		self.PendingTheme[key] = color
		self.ThemeSession = self.ThemeSession or {}
		self.ThemeSettleToken = (self.ThemeSettleToken or 0) + 1
		local settleToken = self.ThemeSettleToken
		task.delay(0.5, function()
			if self.ThemeSettleToken ~= settleToken or self.ThemeQueued then
				return
			end
			local session = self.ThemeSession
			self.ThemeSession = nil
			if session and next(session) ~= nil then
				self:_ThemeScan(session, true)
			end
		end)
		if self.ThemeQueued then
			return
		end
		self.ThemeQueued = true
		task.delay(0.1, function()
			self.ThemeQueued = false
			local pending = self.PendingTheme
			self.PendingTheme = {}
			self.ThemeFastPass = true
			self:ApplyTheme(pending)
			self.ThemeFastPass = false
		end)
	end

	function Library:SetGradientRotation(degrees)
		Theme.GradientRotation = (tonumber(degrees) or 45) % 361
		if self.GradientQueued then
			return
		end
		self.GradientQueued = true
		task.defer(function()
			self.GradientQueued = false
			local gradients = self.Gradients
			local rotation = Theme.GradientRotation
			for position = #gradients, 1, -1 do
				local gradient = gradients[position]
				if gradient.Parent then
					gradient.Rotation = rotation
				else
					table.remove(gradients, position)
				end
			end
		end)
	end

	function Library:ApplyPreset(name)
		local preset = ThemePresets[name]
		if not preset then
			return false
		end
		self:ApplyTheme(preset)
		return true
	end

	function Library:GetThemePresets()
		return table.clone(ThemePresetNames)
	end

	function Library:SetAccent(color)
		if typeof(color) ~= "Color3" then
			return
		end
		self:SetThemeColor("Accent", color)
	end

