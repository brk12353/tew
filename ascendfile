	function Section:AddToggle(options)
		options = options or {}
		local name = tostring(options.Name or "Toggle")
		local description = options.Description
		local holder = BuildTile(self, description and 46 or 36)
		Padding(holder, 0, 8, 0, 10)
		Row(holder, 8)
		local title = BuildLabelBlock(holder, name, description)
		local hovering = false
		local toggle
		toggle = BuildToggle(holder, options, self, function(on, instant)
			Tween(title, { TextColor3 = (on or hovering) and Theme.Text or Theme.TextDim }, instant and 0 or Motion.Base)
		end)
		HoverTile(holder, function()
			hovering = true
			Tween(title, { TextColor3 = Theme.Text }, Motion.Fast)
		end, function()
			hovering = false
			if not toggle.Value then
				Tween(title, { TextColor3 = Theme.TextDim }, Motion.Fast)
			end
		end)
		holder:SetAttribute("AscendSwitchOnly", true)
		AttachTooltip(title, options.Tooltip)
		self:_Register(name, holder)
		return toggle
	end

	function Section:AddSlider(options)
		options = options or {}
		local name = tostring(options.Name or "Slider")
		local minimum = tonumber(options.Min) or 0
		local maximum = tonumber(options.Max) or 100
		if maximum < minimum then
			minimum, maximum = maximum, minimum
		end
		local increment = tonumber(options.Increment) or 1
		if increment <= 0 then
			increment = 1
		end
		local suffix = tostring(options.Suffix or "")
		local range = options.Range == true
		local fraction = string.match(tostring(increment), "%.(%d+)$")
		local decimals = fraction and #fraction or 0

		local function snap(value)
			value = tonumber(value) or minimum
			value = math.clamp(value, minimum, maximum)
			value = minimum + math.floor((value - minimum) / increment + 0.5) * increment
			value = math.clamp(value, minimum, maximum)
			local factor = 10 ^ decimals
			return math.floor(value * factor + 0.5) / factor
		end
		local function format(value)
			return string.format("%." .. tostring(decimals) .. "f", value) .. suffix
		end
		local function normalize(value)
			if range then
				local low, high = minimum, maximum
				if type(value) == "table" then
					low = value[1] or value.Min or value.min or minimum
					high = value[2] or value.Max or value.max or maximum
				end
				low, high = snap(low), snap(high)
				if low > high then
					low, high = high, low
				end
				return { low, high }
			end
			return snap(value)
		end

		local slider = {
			Type = "Slider",
			Name = name,
			Flag = options.Flag,
			Callback = options.Callback,
			Min = minimum,
			Max = maximum,
			Increment = increment,
			Suffix = suffix,
			Range = range,
			Value = normalize(options.Default),
		}

		local holder = BuildTile(self, 52, "Frame")
		local top = Create("Frame", {
			Position = UDim2.fromOffset(10, 6),
			Size = UDim2.new(1, -18, 0, 20),
			BackgroundTransparency = 1,
			Parent = holder,
		})
		Row(top, 8)
		local title = Text({
			Text = name,
			Size = UDim2.new(0, 0, 1, 0),
			TextColor3 = Theme.TextDim,
			TextTruncate = Enum.TextTruncate.AtEnd,
			LayoutOrder = 1,
			Parent = top,
		})
		Fill(title)
		local valuePill = Create("Frame", {
			Size = UDim2.fromOffset(0, 20),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundColor3 = Theme.Raised,
			BackgroundTransparency = 1,
			LayoutOrder = 2,
			Parent = top,
		})
		Round(valuePill, 4)
		local valueStroke = Stroke(valuePill, Theme.Line)
		valueStroke.Transparency = 1
		Padding(valuePill, 0, 7, 0, 7)
		local valueBox = Create("TextBox", {
			Size = UDim2.new(0, 0, 1, 0),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundTransparency = 1,
			FontFace = Fonts.SemiBold,
			TextSize = 12,
			TextColor3 = Theme.Text,
			ClearTextOnFocus = false,
			Parent = valuePill,
		})
		local track = Create("Frame", {
			Position = UDim2.fromOffset(10, 37),
			Size = UDim2.new(1, -20, 0, 5),
			BackgroundColor3 = Theme.Raised,
			Parent = holder,
		})
		Round(track, 2)
		local fill = Create("Frame", {
			Size = UDim2.fromScale(0, 1),
			BackgroundColor3 = Color3.new(1, 1, 1),
			ZIndex = 1,
			Parent = track,
		})
		Round(fill, 2)
		local fillGradient = TrackGradient(Create("UIGradient", {
			Color = ColorSequence.new(Theme.Accent, Theme.Accent2),
			Rotation = Theme.GradientRotation,
			Parent = fill,
		}))
		local function makeKnob()
			local knob = Create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0, 0.5),
				Size = UDim2.fromOffset(14, 8),
				BackgroundColor3 = Theme.Text,
				ZIndex = 3,
				Parent = track,
			})
			Round(knob, 3)
			local ring = Stroke(knob, Theme.Accent, 1, 2)
			return knob, ring
		end
		local knobA, ringA = makeKnob()
		local knobB, ringB = nil, nil
		if range then
			knobB, ringB = makeKnob()
		end
		local hitbox = Create("TextButton", {
			Position = UDim2.fromOffset(4, 28),
			Size = UDim2.new(1, -8, 0, 22),
			BackgroundTransparency = 1,
			ZIndex = 4,
			Parent = holder,
		})

		local dragging = false
		local activeKnob = 1
		local hovering = false

		local function percentOf(value)
			local span = maximum - minimum
			if span == 0 then
				return 0
			end
			return (value - minimum) / span
		end

		local function render(instant)
			local duration = instant and 0 or 0.08
			if range then
				local low = percentOf(slider.Value[1])
				local high = percentOf(slider.Value[2])
				Tween(fill, { Position = UDim2.fromScale(low, 0), Size = UDim2.fromScale(high - low, 1) }, duration)
				Tween(knobA, { Position = UDim2.fromScale(low, 0.5) }, duration)
				Tween(knobB, { Position = UDim2.fromScale(high, 0.5) }, duration)
				if not valueBox:IsFocused() then
					valueBox.Text = format(slider.Value[1]) .. " to " .. format(slider.Value[2])
				end
			else
				local percent = percentOf(slider.Value)
				Tween(fill, { Size = UDim2.fromScale(percent, 1) }, duration)
				Tween(knobA, { Position = UDim2.fromScale(percent, 0.5) }, duration)
				if not valueBox:IsFocused() then
					valueBox.Text = format(slider.Value)
				end
			end
		end

		function slider:Set(value, silent)
			local new = normalize(value)
			local changed
			if range then
				changed = new[1] ~= self.Value[1] or new[2] ~= self.Value[2]
			else
				changed = new ~= self.Value
			end
			self.Value = new
			SetFlag(self)
			render(false)
			if changed and not silent then
				SafeCall(self.Callback, CloneValue(new))
			end
			if changed and self.Watchers then
				for _, watcher in ipairs(self.Watchers) do
					SafeCall(watcher, CloneValue(new))
				end
			end
		end

		function slider:Get()
			return CloneValue(self.Value)
		end

		local function valueAt(x)
			local width = track.AbsoluteSize.X
			if width <= 0 then
				return nil
			end
			local percent = math.clamp((x - track.AbsolutePosition.X) / width, 0, 1)
			return minimum + (maximum - minimum) * percent
		end

		local function apply(x)
			local value = valueAt(x)
			if value == nil then
				return
			end
			if range then
				local low, high = slider.Value[1], slider.Value[2]
				if activeKnob == 1 then
					low = math.min(value, high)
				else
					high = math.max(value, low)
				end
				slider:Set({ low, high })
			else
				slider:Set(value)
			end
		end

		local function setActive(state)
			local rings = { ringA }
			if ringB then
				table.insert(rings, ringB)
			end
			for _, ring in ipairs(rings) do
				Tween(ring, { Transparency = state and 0.7 or 1 }, Motion.Fast)
			end
			Tween(title, { TextColor3 = (state or hovering) and Theme.Text or Theme.TextDim }, Motion.Fast)
			Tween(valueStroke, { Color = Theme.Accent, Transparency = state and 0.4 or 1 }, Motion.Fast)
			local hook = state and options.OnDragStart or options.OnDragEnd
			if type(hook) == "function" then
				task.spawn(hook)
			end
		end

		local function stopDrag()
			if not dragging then
				return
			end
			dragging = false
			setActive(false)
			EndGrab(slider)
		end

		hitbox.InputBegan:Connect(function(input)
			if not IsPrimary(input) or dragging then
				return
			end
			if not BeginGrab(slider, holder, stopDrag) then
				return
			end
			dragging = true
			if range then
				local value = valueAt(input.Position.X) or minimum
				local distanceLow = math.abs(value - slider.Value[1])
				local distanceHigh = math.abs(value - slider.Value[2])
				if distanceLow == distanceHigh then
					activeKnob = value < slider.Value[1] and 1 or 2
				else
					activeKnob = distanceLow < distanceHigh and 1 or 2
				end
			end
			setActive(true)
			apply(input.Position.X)
		end)
		Connect(UserInputService.InputChanged, function(input)
			if dragging and IsMove(input) then
				apply(input.Position.X)
			end
		end)
		Connect(UserInputService.InputEnded, function(input)
			if dragging and IsPrimary(input) then
				stopDrag()
			end
		end)
		HoverTile(holder, function()
			hovering = true
			if not dragging then
				Tween(title, { TextColor3 = Theme.Text }, Motion.Fast)
			end
		end, function()
			hovering = false
			if not dragging then
				Tween(title, { TextColor3 = Theme.TextDim }, Motion.Fast)
			end
		end)
		valueBox.Focused:Connect(function()
			Tween(valueStroke, { Color = Theme.Accent, Transparency = 0 }, Motion.Fast)
			Tween(valuePill, { BackgroundTransparency = 0 }, Motion.Fast)
		end)
		valueBox.FocusLost:Connect(function()
			Tween(valueStroke, { Transparency = 1 }, Motion.Fast)
			Tween(valuePill, { BackgroundTransparency = 1 }, Motion.Fast)
			if range then
				local numbers = {}
				for number in string.gmatch(valueBox.Text, "%-?%d+%.?%d*") do
					table.insert(numbers, tonumber(number))
				end
				if #numbers >= 2 then
					slider:Set({ numbers[1], numbers[2] })
				end
			else
				local number = tonumber((string.gsub(valueBox.Text, "[^%d%.%-]", "")))
				if number then
					slider:Set(number)
				end
			end
			render(true)
		end)

		OnTheme(function()
			fillGradient.Color = ColorSequence.new(Theme.Accent, Theme.Accent2)
			fillGradient.Rotation = Theme.GradientRotation
			ringA.Color = Theme.Accent
			if ringB then
				ringB.Color = Theme.Accent
			end
		end)
		render(true)
		RegisterElement(slider)
		AttachTooltip(title, options.Tooltip)
		self:_Register(name, holder)
		return slider
	end

	function Section:AddButton(options)
		if type(options) == "string" then
			options = { Name = options }
		end
		options = options or {}
		local name = tostring(options.Name or "Button")
		local primary = options.Style == "Primary"
		local button = { Type = "Button", Name = name, Callback = options.Callback }

		local wrapper = Create("Frame", {
			Size = UDim2.new(1, 0, 0, 40),
			BackgroundTransparency = 1,
			LayoutOrder = self:_Next(),
			Parent = self.Frame,
		})
		Padding(wrapper, 3, 4, 3, 4)
		local holder = Create("TextButton", {
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = primary and Theme.Accent or Theme.Raised,
			Parent = wrapper,
		})
		Round(holder, 8)
		local stroke = Stroke(holder, primary and Theme.Accent or Theme.Line)
		if primary then
			Create("UIGradient", {
				Rotation = 90,
				Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(205, 205, 220)),
				Parent = holder,
			})
		end
		PressScale(holder, 0.97)
		local content = Create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.new(0, 0, 1, 0),
			AutomaticSize = Enum.AutomaticSize.X,
			BackgroundTransparency = 1,
			Parent = holder,
		})
		Row(content, 7)
		local restIcon = primary and Theme.OnAccent or Theme.TextDim
		local icon, tintIcon = Glyph(content, { options.Icon }, 16, restIcon, nil, { LayoutOrder = 1 })
		local label = Text({
			Text = name,
			FontFace = Fonts.SemiBold,
			TextSize = 13,
			TextColor3 = primary and Theme.OnAccent or Theme.Text,
			Size = UDim2.new(0, 0, 1, 0),
			AutomaticSize = Enum.AutomaticSize.X,
			LayoutOrder = 2,
			Parent = content,
		})

		local function restBackground()
			return primary and Theme.Accent or Theme.Raised
		end
		local function hoverBackground()
			if primary then
				return Tinted(Theme.Accent, 0.08)
			end
			return Theme.Hover
		end
		holder.MouseEnter:Connect(function()
			Tween(holder, { BackgroundColor3 = hoverBackground() }, Motion.Fast)
			if not primary then
				Tween(stroke, { Color = Theme.LineStrong }, Motion.Fast)
				if icon then
					tintIcon(Theme.Text)
				end
			end
		end)
		holder.MouseLeave:Connect(function()
			Tween(holder, { BackgroundColor3 = restBackground() }, Motion.Fast)
			if not primary then
				Tween(stroke, { Color = Theme.Line }, Motion.Fast)
				if icon then
					tintIcon(restIcon)
				end
			end
		end)
		holder.Activated:Connect(function()
			SafeCall(button.Callback)
		end)
		if primary then
			OnTheme(function()
				holder.BackgroundColor3 = Theme.Accent
				stroke.Color = Theme.Accent
				label.TextColor3 = Theme.OnAccent
				if icon then
					tintIcon(Theme.OnAccent)
				end
			end)
		end

		function button:SetText(text)
			label.Text = tostring(text)
			self.Name = label.Text
		end

		function button:Fire()
			SafeCall(self.Callback)
		end

		AttachTooltip(holder, options.Tooltip)
		self:_Register(name, wrapper)
		return button
	end

	function Section:AddThemeEditor()
		local controls = { Theme = {} }
		controls.Preset = self:AddDropdown({
			Name = "Theme preset",
			Options = ThemePresetNames,
			Default = DefaultPreset,
			Flag = "Ascend_ThemePreset",
			Callback = function(name)
				if Library:ApplyPreset(name) then
					for key, picker in pairs(controls.Theme) do
						picker:Set(Theme[key], true)
					end
				end
			end,
		})
		controls.Rotation = self:AddSlider({
			Name = "Accent gradient angle",
			Min = 0,
			Max = 360,
			Default = Theme.GradientRotation,
			Increment = 5,
			Suffix = " deg",
			Flag = "Ascend_GradientRotation",
			Callback = function(value)
				Library:SetGradientRotation(value)
			end,
		})
		for _, entry in ipairs(ThemeKeys) do
			controls.Theme[entry.Key] = self:AddColorPicker({
				Name = entry.Label,
				Default = Theme[entry.Key],
				Flag = "Ascend_Theme_" .. entry.Key,
				Callback = function(color)
					Library:SetThemeColor(entry.Key, color)
				end,
			})
		end
		controls.Accent = controls.Theme.Accent
		Library.ThemeControls = controls
		return controls
	end

	function Section:AddButtons(list)
		local wrapper = Create("Frame", {
			Size = UDim2.new(1, 0, 0, 40),
			BackgroundTransparency = 1,
			LayoutOrder = self:_Next(),
			Parent = self.Frame,
		})
		Padding(wrapper, 3, 4, 3, 4)
		local layout = Row(wrapper, 6)
		layout.HorizontalFlex = Enum.UIFlexAlignment.Fill
		local buttons = {}
		local names = {}
		for index, info in ipairs(list or {}) do
			local holder = Create("TextButton", {
				Size = UDim2.new(0, 0, 1, 0),
				BackgroundColor3 = Theme.Raised,
				LayoutOrder = index,
				Parent = wrapper,
			})
			Round(holder, 4)
			local stroke = Stroke(holder, Theme.Line)
			PressScale(holder, 0.96)
			local content = Create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.new(1, -12, 1, 0),
				BackgroundTransparency = 1,
				Parent = holder,
			})
			local contentLayout = Row(content, 6)
			contentLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
			local icon, tintIcon = Glyph(content, { info.Icon }, 14, Theme.TextDim, nil, { LayoutOrder = 1 })
			local buttonLabel = Text({
				Text = tostring(info.Name or "Button"),
				FontFace = Fonts.SemiBold,
				TextSize = 12,
				TextTruncate = Enum.TextTruncate.AtEnd,
