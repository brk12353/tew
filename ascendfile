	local function SweepBounds(object)
		local position = object.AbsolutePosition
		local size = object.AbsoluteSize
		local minX, minY = position.X, position.Y
		local maxX, maxY = minX + size.X, minY + size.Y
		local current = object.Parent
		while current and current:IsA("GuiObject") do
			if current.ClipsDescendants or current:IsA("CanvasGroup") then
				local p = current.AbsolutePosition
				local z = current.AbsoluteSize
				minX = math.max(minX, p.X)
				minY = math.max(minY, p.Y)
				maxX = math.min(maxX, p.X + z.X)
				maxY = math.min(maxY, p.Y + z.Y)
			end
			current = current.Parent
		end
		return minX, minY, maxX, maxY
	end

	local function ShineTargets(root)
		local list = {}
		local function consider(object)
			local isText = object:IsA("TextLabel") or object:IsA("TextButton")
			local isImage = object:IsA("ImageLabel") or object:IsA("ImageButton")
			if not (isText or isImage) or not object.Visible then
