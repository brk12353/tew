	function Library:_BindInput()
		Connect(UserInputService.InputBegan, function(input, gameProcessed)
			local binder = self.ActiveBinder
			if binder then
				binder:_CaptureBegan(input)
				return
			end
			if self.Binding then
				return
			end
			if gameProcessed then
				local padPress = IsGamepadInput(input) and UserInputService:GetFocusedTextBox() == nil and not GamepadCursorOn()
				if not padPress then
					return
				end
			end
			local heldSet = nil
			local best = -1
			local winners = {}
			for _, keybind in ipairs(self.Keybinds) do
				if keybind.Value ~= nil and Matches(input, keybind.Value) and keybind:IsUsable() then
					if not heldSet then
						heldSet = {}
						for _, name in ipairs(HeldModifiers(ModifierOf(input.KeyCode))) do
							heldSet[name] = true
						end
					end
					local satisfied = true
					for _, mod in ipairs(keybind.Modifiers) do
						if not heldSet[mod] then
							satisfied = false
							break
						end
					end
					if satisfied then
						local count = #keybind.Modifiers
						if count > best then
							best = count
							winners = { keybind }
						elseif count == best then
							table.insert(winners, keybind)
						end
					end
				end
			end
			for _, keybind in ipairs(winners) do
				keybind:_Press()
			end
		end)
		Connect(UserInputService.InputEnded, function(input)
			local binder = self.ActiveBinder
			if binder then
				binder:_CaptureEnded(input)
			end
			for _, keybind in ipairs(self.Keybinds) do
				if keybind.Value ~= nil and Matches(input, keybind.Value) then
					keybind:_Release()
				end
			end
		end)
	end

