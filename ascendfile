			local count = 0
			local stick = true
			local scrolling = false
			local log = {}

			local function bottom()
				return math.max(scroll.AbsoluteCanvasSize.Y - scroll.AbsoluteWindowSize.Y, 0)
			end
			local function toBottom()
				scrolling = true
				scroll.CanvasPosition = Vector2.new(0, bottom())
				scrolling = false
			end
			scroll:GetPropertyChangedSignal("CanvasPosition"):Connect(function()
				if not scrolling then
					stick = scroll.CanvasPosition.Y >= bottom() - 6
				end
			end)
			scroll:GetPropertyChangedSignal("AbsoluteCanvasSize"):Connect(function()
				if stick then
					toBottom()
				end
			end)

			local filterFn = nil
			local function matches(entry)
				if filterFn and not filterFn(entry.Tags) then
					return false
				end
				return query == "" or string.find(entry.Search, query, 1, true) ~= nil
			end
			local function refreshEmpty()
				local shown = 0
				for _, entry in ipairs(entries) do
					if entry.Label.Visible then
						shown += 1
					end
				end
				if #entries == 0 then
					empty.Text = tostring(logOptions.Empty or "Nothing yet")
				elseif query ~= "" then
					empty.Text = "No messages match your search"
				else
					empty.Text = "Nothing matches this filter"
				end
				empty.Visible = shown == 0
				return shown
			end
			local function applyFilter()
				for _, entry in ipairs(entries) do
					entry.Label.Visible = matches(entry)
				end
				refreshEmpty()
				stick = true
				task.defer(toBottom)
				if logOptions.OnFilter then
					SafeCall(logOptions.OnFilter, query, log)
				end
			end
			if searchBox then
				searchBox:GetPropertyChangedSignal("Text"):Connect(function()
					local text = string.lower(searchBox.Text)
					text = text:gsub("^%s+", ""):gsub("%s+$", "")
					if text ~= query then
						query = text
						applyFilter()
					end
				end)
			end

			function log:SetFilter(fn)
				filterFn = type(fn) == "function" and fn or nil
				applyFilter()
			end

			local useAlternate = logOptions.Alternate == true
			local transform = nil
			local function shape(text)
				text = tostring(text)
				if transform then
					local ok, result = pcall(transform, text)
					if ok and type(result) == "string" then
						return result
					end
				end
				return text
			end
			local function render(entry)
				local prefix = shape((useAlternate and entry.AltPrefix) or entry.Prefix)
				local rich = '<font color="#' .. entry.Color:ToHex() .. '">' .. EscapeRich(prefix) .. "</font> " .. EscapeRich(shape(entry.Body))
				if entry.Style == "event" then
					rich = '<i><font transparency="0.25">' .. rich .. "</font></i>"
				end
				entry.Label.Text = rich
				entry.Plain = shape((useAlternate and entry.AltPlain) or entry.BasePlain)
				entry.Search = string.lower(entry.Plain)
			end

			function log:SetTransform(fn)
				transform = type(fn) == "function" and fn or nil
				for _, entry in ipairs(entries) do
					render(entry)
				end
				applyFilter()
			end

			function log:SetAlternate(enabled)
				enabled = enabled == true
				if enabled == useAlternate then
					return
				end
				useAlternate = enabled
				for _, entry in ipairs(entries) do
					if entry.AltPrefix or entry.AltPlain then
						render(entry)
					end
				end
				applyFilter()
			end

			function log:Push(prefix, prefixColor, text, plainLine, style, tags)
				count += 1
				local color = typeof(prefixColor) == "Color3" and prefixColor or Theme.Accent
				local plainText = tostring(plainLine or (tostring(prefix) .. " " .. tostring(text)))
				tags = type(tags) == "table" and tags or {}
				local label = Text({
					Text = "",
					RichText = true,
					TextWrapped = true,
					TextSize = 12,
					FontFace = Fonts.Regular,
					TextColor3 = Theme.TextDim,
					TextYAlignment = Enum.TextYAlignment.Top,
					Size = UDim2.new(1, 0, 0, 0),
					AutomaticSize = Enum.AutomaticSize.Y,
					LayoutOrder = count,
					Parent = scroll,
				})
				if style == "mention" then
					label.BackgroundColor3 = Theme.Accent
					label.BackgroundTransparency = 0.86
					Round(label, 4)
					Padding(label, 2, 4, 2, 4)
				end
				local entry = {
					Label = label,
					Prefix = tostring(prefix),
					AltPrefix = tags.AltPrefix,
					Color = color,
					Body = tostring(text),
					Style = style,
					BasePlain = plainText,
					AltPlain = tags.AltPlain,
					Tags = tags,
				}
				render(entry)
				label.Visible = matches(entry)
				table.insert(entries, entry)
				while #entries > limit do
					table.remove(entries, 1).Label:Destroy()
				end
				refreshEmpty()
				if stick then
					task.defer(toBottom)
				end
			end

			function log:Clear()
				for _, entry in ipairs(entries) do
					entry.Label:Destroy()
				end
				table.clear(entries)
				stick = true
				refreshEmpty()
			end

			function log:Text(onlyShown)
				local out = {}
				for _, entry in ipairs(entries) do
					if not onlyShown or entry.Label.Visible then
						table.insert(out, entry.Plain)
					end
				end
				return table.concat(out, "\n")
			end

			function log:Count()
				return #entries
			end

			function log:Shown()
				local shown = 0
				for _, entry in ipairs(entries) do
					if entry.Label.Visible then
						shown += 1
					end
				end
				return shown
			end

			function log:Query()
				return query
			end

			return log
		end

		function panel:AddGraph(graphOptions)
			graphOptions = graphOptions or {}
			local samples = math.clamp(tonumber(graphOptions.Count) or 40, 8, 120)
			local ceiling = tonumber(graphOptions.Max) or 100
			local wrap = Create("Frame", {
				Size = UDim2.new(1, 0, 0, (tonumber(graphOptions.Height) or 36) + 18),
				BackgroundTransparency = 1,
				LayoutOrder = nextOrder(),
				Parent = body,
			})
			Padding(wrap, 2, 6, 2, 6)
			local caption = Text({
				Text = tostring(graphOptions.Name or ""),
				TextSize = 11,
				FontFace = Fonts.Medium,
				TextColor3 = Theme.TextFaint,
				Size = UDim2.new(1, 0, 0, 14),
				Parent = wrap,
			})
			local reading = Text({
				Text = "",
				TextSize = 11,
				FontFace = Fonts.SemiBold,
				TextColor3 = Theme.TextDim,
				TextXAlignment = Enum.TextXAlignment.Right,
				Size = UDim2.new(1, 0, 0, 14),
				Parent = wrap,
			})
			local chart = Create("Frame", {
				Position = UDim2.fromOffset(0, 16),
				Size = UDim2.new(1, 0, 1, -16),
				BackgroundColor3 = Theme.Base,
				BackgroundTransparency = 0.4,
				ClipsDescendants = true,
				Parent = wrap,
			})
			Round(chart, 4)
			local bars = {}
			for index = 1, samples do
				bars[index] = Create("Frame", {
					AnchorPoint = Vector2.new(0, 1),
					Position = UDim2.new((index - 1) / samples, 1, 1, 0),
					Size = UDim2.new(1 / samples, -1, 0, 0),
					BackgroundColor3 = Theme.Accent,
					BackgroundTransparency = 0.15,
					Parent = chart,
				})
			end
			local values = {}
			return function(value)
				value = tonumber(value) or 0
				table.insert(values, value)
				if #values > samples then
					table.remove(values, 1)
				end
				local top = ceiling
				for _, sample in ipairs(values) do
					top = math.max(top, sample)
				end
				local offset = samples - #values
				for index = 1, samples do
					local sample = values[index - offset]
					local bar = bars[index]
					if sample then
						bar.Size = UDim2.new(1 / samples, -1, math.clamp(sample / top, 0.02, 1), 0)
						local color = graphOptions.Color and graphOptions.Color(sample)
						bar.BackgroundColor3 = typeof(color) == "Color3" and color or Theme.Accent
						bar.Visible = true
					else
						bar.Visible = false
					end
				end
				reading.Text = tostring(math.floor(value + 0.5)) .. tostring(graphOptions.Suffix or "")
			end, wrap
		end

