		MakeDraggable(dragZone, shell, markDragged)
		MakeDraggable(brand, shell, markDragged)

		local function updateScale()
			local camera = workspace.CurrentCamera
			if not camera then
				return
			end
			local viewport = camera.ViewportSize
			local fit = math.min((viewport.X - 24) / size.X, (viewport.Y - 56) / size.Y)
			local scale = math.min(fit, 1) * (window.UserScale or 1)
			scale = math.clamp(math.min(scale, math.max(fit, 0.4)), 0.4, 2)
			responsive.Scale = scale
			window.Scale = scale
			Library:_ApplyOverlayScale(scale)
			Library:_ReflowPopovers()
			if not window.Dragged then
				shell.Position = UDim2.new(0.5, 0, 0.5, -math.floor(size.Y * scale / 2))
			end
		end
		window._UpdateScale = updateScale
		updateScale()
		if workspace.CurrentCamera then
			Connect(workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"), updateScale)
		end

		closeButton.Activated:Connect(function()
			window:SetVisible(false)
			local hint = nil
			if IsTouchOnly() then
				hint = "Tap the button on the screen to bring it back."
			elseif UsingGamepad() and window.GamepadToggleKey then
				hint = "Press " .. KeyName(window.GamepadToggleKey) .. " to bring it back."
			elseif window.ToggleKey then
				hint = "Press " .. KeyName(window.ToggleKey) .. " to bring it back."
			end
			if hint then
				Library:Notify({
					Title = "Menu hidden",
					Content = hint,
					Duration = 3.5,
					Icon = "eye-off",
				})
			end
		end)
		minimizeButton.Activated:Connect(function()
			window:SetMinimized(not window.Minimized)
		end)

		Connect(UserInputService.InputBegan, function(input, gameProcessed)
			if Library.Binding or window.Destroyed then
				return
			end
			if IsGamepadInput(input) then
				if window.GamepadToggleKey and input.KeyCode == window.GamepadToggleKey and UserInputService:GetFocusedTextBox() == nil then
					window:Toggle()
					if window.Visible and window.GamepadCursor then
						pcall(function()
							GamepadService:EnableGamepadCursor(window.Shell)
						end)
					end
				end
				return
			end
			if gameProcessed then
				return
			end
			if window.ToggleKey and input.KeyCode == window.ToggleKey then
				window:Toggle()
			end
		end)

		if options.Watermark ~= false then
			self:SetWatermarkVisible(true)
		end
		if options.KeybindList == true then
			self:SetKeybindListVisible(true)
		end
		self:_ApplyOverlayOpacity()
		window.SettingsPopover = window:_BuildSettings()
		profileRow.Activated:Connect(function()
			Library:_OpenPopover(window.SettingsPopover, profileRow, "left")
		end)

		task.defer(function()
			if not window.Destroyed then
				window:SetVisible(true)
			end
		end)

		return window
	end

	function Window:SetVisible(state)
		if self.Destroyed then
			return
		end
		self.Visible = state
		self.AnimToken += 1
		local token = self.AnimToken
		Library:_CloseAllPopovers()
		if state then
			self.Shell.Visible = true
			Tween(self.AnimScale, { Scale = 1 }, Motion.Slow)
			Tween(self.Canvas, { GroupTransparency = 0 }, Motion.Base, Enum.EasingStyle.Quad)
			self:_SetBubble(false)
		else
			Tween(self.AnimScale, { Scale = 0.97 }, Motion.Base, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			Tween(self.Canvas, { GroupTransparency = 1 }, Motion.Base * 0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			task.delay(Motion.Base + 0.03, function()
				if self.AnimToken == token and not self.Destroyed then
					self.Shell.Visible = false
				end
			end)
			self.SearchBox:ReleaseFocus()
			Library:_HideTooltip()
			self:_SetBubble(true)
			if GamepadCursorOn() then
				pcall(function()
					GamepadService:DisableGamepadCursor()
				end)
			end
		end
	end

	function Window:_SetBubble(state)
		if state and not IsTouchOnly() then
			state = false
		end
		self.BubbleToken += 1
		local token = self.BubbleToken
		if state then
			self.Bubble.Visible = true
			Tween(self.BubbleScale, { Scale = 1 }, Motion.Slow)
		else
			Tween(self.BubbleScale, { Scale = 0 }, Motion.Fast, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			task.delay(Motion.Fast + 0.03, function()
				if self.BubbleToken == token and not self.Destroyed then
					self.Bubble.Visible = false
				end
			end)
		end
	end

	function Window:Toggle()
		self:SetVisible(not self.Visible)
	end

	function Window:SetMinimized(state)
		if self.Destroyed then
			return
		end
		self.Minimized = state
		Library:_CloseAllPopovers()
		local target = self.Size
		if state then
			target = UDim2.fromOffset(self.Width, self.HeaderHeight)
		end
		Tween(self.Shell, { Size = target }, Motion.Slow)
		local glyph = self.MinimizeGlyph
		if glyph then
			self.MinimizeToken = (self.MinimizeToken or 0) + 1
			local token = self.MinimizeToken
			local scale = glyph:FindFirstChildOfClass("UIScale") or Create("UIScale", { Parent = glyph })
			Tween(scale, { Scale = 0 }, Motion.Fast, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			Tween(glyph, { Rotation = state and 90 or -90 }, Motion.Fast, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			task.delay(Motion.Fast, function()
				if self.MinimizeToken ~= token then
					return
				end
				if glyph:IsA("ImageLabel") then
					local resolved = ResolveIcon(state and "maximize-2" or "minus")
					if resolved then
						ApplyIcon(glyph, resolved)
					end
				end
				glyph.Rotation = state and -90 or 90
				Tween(glyph, { Rotation = 0 }, Motion.Slow, Enum.EasingStyle.Back)
				Tween(scale, { Scale = 1 }, Motion.Slow, Enum.EasingStyle.Back)
			end)
		end
	end

	function Library:IsTouchOnly()
		return IsTouchOnly()
	end

	function Window:SetToggleKey(key)
		if typeof(key) == "EnumItem" and key.EnumType == Enum.KeyCode and not IsGamepadKey(key) then
			self.ToggleKey = key
		end
	end

	function Window:SetGamepadToggleKey(key)
		if key == nil or key == false then
			self.GamepadToggleKey = nil
		elseif IsGamepadKey(key) then
			self.GamepadToggleKey = key
		end
	end

	function Window:Notify(options)
		Library:Notify(options)
	end

	function Window:Destroy()
		Library:Destroy()
	end

	function Window:SetUserScale(scale)
		self.UserScale = math.clamp(tonumber(scale) or 1, 0.5, 1.6)
		if self._UpdateScale then
			self._UpdateScale()
		end
	end

	function Window:_BuildSettings()
		local popover = Library:_CreatePopover(276, "Interface", "settings")
		popover.Frame.BackgroundColor3 = Theme.Base
		popover.Frame.BackgroundTransparency = 1 - self.Opacity
		local settingsBackdrop = Create("ImageLabel", {
			Name = "Backdrop",
			Size = UDim2.fromScale(1, 1),
			BackgroundTransparency = 1,
			ScaleType = Enum.ScaleType.Crop,
			Image = "",
			Visible = false,
			ZIndex = 0,
			Parent = popover.Frame,
		})
		local settingsDim = Create("Frame", {
			Name = "Dim",
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Theme.Base,
			BackgroundTransparency = self.BackdropDim.BackgroundTransparency,
			Parent = settingsBackdrop,
		})
		local function mirrorBackdrop()
			settingsBackdrop.Image = self.Backdrop.Image
			settingsBackdrop.Visible = self.Backdrop.Visible
			settingsDim.BackgroundTransparency = self.BackdropDim.BackgroundTransparency
		end
		self.Backdrop:GetPropertyChangedSignal("Image"):Connect(mirrorBackdrop)
		self.Backdrop:GetPropertyChangedSignal("Visible"):Connect(mirrorBackdrop)
		self.BackdropDim:GetPropertyChangedSignal("BackgroundTransparency"):Connect(mirrorBackdrop)
		mirrorBackdrop()
		local scroll = Create("ScrollingFrame", {
			Size = UDim2.new(1, 0, 0, 360),
			BackgroundTransparency = 1,
			ScrollBarThickness = 2,
			ScrollBarImageColor3 = Theme.LineStrong,
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollingDirection = Enum.ScrollingDirection.Y,
			LayoutOrder = 1,
			Parent = popover.Content,
		})
		List(scroll, 2)
		AutoScrollbar(scroll, 2)
		Padding(scroll, 0, 6, 0, 0)
		local panel = NewSection({
			Frame = scroll,
			Name = "Interface",
			Nested = true,
			Popover = popover,
		})
		local function heading(text)
			local label = Text({
				Text = text,
				FontFace = Fonts.SemiBold,
				TextSize = 11,
				TextColor3 = Theme.TextFaint,
				Size = UDim2.new(1, 0, 0, 24),
				TextYAlignment = Enum.TextYAlignment.Bottom,
				LayoutOrder = panel:_Next(),
				Parent = scroll,
			})
			Padding(label, 0, 0, 4, 10)
		end
		local fontNames = {}
		for _, choice in ipairs(FontChoices) do
			table.insert(fontNames, choice.Name)
		end
		local defaults = {
			Scale = 100,
			Radius = Theme.Radius,
			Opacity = math.floor(self.Opacity * 100 + 0.5),
			Panels = math.floor(Library.PanelOpacity * 100 + 0.5),
			Accent = Theme.Accent,
			Font = Library.FontName,
			Dim = 55,
		}
		local controls = {}

		heading("Layout")
		controls.Scale = panel:AddSlider({
			Name = "Interface scale",
			Min = 50,
			Max = 160,
			Default = defaults.Scale,
			Increment = 5,
			Suffix = "%",
			Flag = "Ascend_Scale",
			Callback = function(value)
				self:SetUserScale(value / 100)
			end,

		})
		controls.Radius = panel:AddSlider({
			Name = "Corner radius",
			Min = 0,
			Max = 12,
			Default = defaults.Radius,
			Suffix = " px",
			Flag = "Ascend_Radius",
			Callback = function(value)
				Library:SetRadius(value)
			end,
		})
		controls.Font = panel:AddDropdown({
			Name = "Font",
			Options = fontNames,
			Default = defaults.Font,
			Flag = "Ascend_Font",
			Callback = function(name)
				Library:SetFont(name)
			end,
		})

		heading("Look")
		controls.Opacity = panel:AddSlider({
			Name = "Window opacity",
			Min = 20,
			Max = 100,
			Default = defaults.Opacity,
			Increment = 5,
			Suffix = "%",
			Flag = "Ascend_Opacity",
			Callback = function(value)
				Library:SetWindowOpacity(value / 100)
			end,
		})
		controls.Panels = panel:AddSlider({
			Name = "Panel opacity",
			Min = 0,
			Max = 100,
			Default = defaults.Panels,
			Increment = 5,
			Suffix = "%",
			Flag = "Ascend_PanelOpacity",
			Callback = function(value)
				Library:SetPanelOpacity(value / 100)
			end,
		})

		heading("Background")
		controls.Background = panel:AddTextbox({
			Name = "Background image",
			Placeholder = "Roblox image or decal ID",
			Icon = "image",
			Flag = "Ascend_Background",
			Callback = function(text)
				Library:SetBackground(text)
			end,
		})
		local imageMap = {}
		local imageSignature = ""
		controls.ImageFile = panel:AddDropdown({
			Name = "Image file",
			Options = {},
			Placeholder = Library:CanPickImageFiles() and "None found" or "Unavailable",
			Searchable = true,
			Callback = function(fileName)
				local path = fileName and imageMap[fileName]
				if path then
					Library:SetBackgroundFile(path)
				end
			end,
		})
		local function scanImages(announce)
			local images = Library:FindBackgroundImages()
			local names = {}
			local nextMap = {}
			for _, image in ipairs(images) do
				table.insert(names, image.Name)
				nextMap[image.Name] = image.Path
			end
			local signature = table.concat(names, "|")
			if signature ~= imageSignature then
				imageSignature = signature
				imageMap = nextMap
				controls.ImageFile:Refresh(names, true)
			end
			if announce then
				Library:Notify({
					Title = "Backgrounds refreshed",
					Content = #names == 1 and "Found 1 image." or ("Found " .. #names .. " images."),
					Icon = "image",
				})
			end
		end
		local folderHint = Library:CanPickImageFiles()
				and ("Drop pictures into " .. Library:GetBackgroundFolder() .. " and they show up in the list.")
			or "Picking image files needs file access. Paste a Roblox image ID instead."
		panel:AddLabel({ Text = folderHint, Color = Theme.TextFaint })
		panel:AddButtons({
			{
				Name = "Refresh",
				Icon = "refresh-cw",
				Callback = function()
					scanImages(true)
				end,
			},
			{
				Name = "Clear",
				Icon = "x",
				Callback = function()
					controls.Background:Set("", true)
					controls.ImageFile:Set(nil, true)
					Library:SetBackground("")
				end,
			},
		})
		controls.Dim = panel:AddSlider({
			Name = "Background dim",
			Min = 0,
			Max = 95,
			Default = defaults.Dim,
			Increment = 5,
			Suffix = "%",
			Flag = "Ascend_BackgroundDim",
			Callback = function(value)
				Library:SetBackgroundDim(value / 100)
			end,
		})
		if Library:CanPickImageFiles() then
			scanImages(false)
			task.spawn(function()
				while not self.Destroyed do
					task.wait(3)
					if popover.Open then
						scanImages(false)
					end
				end
			end)
		end

		heading("Overlays")
		controls.Watermark = panel:AddToggle({
			Name = "Watermark",
			Default = Library.Watermark and Library.Watermark.Visible or false,
			Flag = "Ascend_Watermark",
			Callback = function(state)
				Library:SetWatermarkVisible(state)
			end,
		})
		controls.KeybindList = panel:AddToggle({
			Name = "Keybind list",
			Default = Library.KeybindList and Library.KeybindList.Visible or false,
			Flag = "Ascend_KeybindList",
			Callback = function(state)
				Library:SetKeybindListVisible(state)
			end,
		})
		controls.Incognito = panel:AddToggle({
			Name = "Incognito mode",
			Default = Library.Incognito == true,
			Flag = "Ascend_Incognito",
			Callback = function(state)
				Library:SetIncognito(state)
			end,
		})
		controls.NotifyEnabled = panel:AddToggle({
			Name = "Show notifications",
			Default = Library.NotificationsEnabled ~= false,
			Flag = "Ascend_NotifyEnabled",
			Callback = function(state)
				Library:SetNotificationsEnabled(state)
			end,
		})
		controls.Notify = panel:AddDropdown({
			Name = "Notification position",
			Options = Library:GetNotifyPlacements(),
			Default = Library:NotifyPlacementLabel(),
			Flag = "Ascend_NotifyPosition",
			Callback = function(choice)
				local key = Library:NotifyPlacementFromLabel(choice)
				if key then
					Library:SetNotifyPosition(key)
				end
			end,
		})
		controls.NotifyAnimation = panel:AddDropdown({
			Name = "Notification animation",
			Options = Library:GetNotifyAnimations(),
			Default = Library.NotifyAnimation or "Slide",
			Flag = "Ascend_NotifyAnimation",
			Callback = function(choice)
				Library:SetNotifyAnimation(choice)
			end,
		})
		controls.NotifyTest = panel:AddButton({
			Name = "Test notification",
			Icon = "bell-ring",
			Callback = function()
				Library:Notify({
					Title = "Test notification",
					Content = "This is how your notifications look.",
					Type = "Info",
					Duration = 3,
				})
			end,
		})
		controls.MenuKey = panel:AddKeybind({
			Name = "Menu key",
			Default = self.ToggleKey,
			Combos = false,
			ShowInList = false,
			Accept = "Keyboard",
			Flag = "Ascend_MenuKey",
			ChangedCallback = function(key)
				if key and key.EnumType == Enum.KeyCode then
					self:SetToggleKey(key)
				end
			end,
		})
		controls.ControllerKey = panel:AddKeybind({
			Name = "Controller menu button",
			Default = self.GamepadToggleKey,
			Combos = false,
			ShowInList = false,
			Accept = "Gamepad",
			Flag = "Ascend_ControllerMenuKey",
			ChangedCallback = function(key)
				self:SetGamepadToggleKey(key)
			end,
		})

		panel:AddDivider()
		panel:AddButton({
			Name = "Reset interface",
			Icon = "rotate-ccw",
			Callback = function()
				Library:Confirm({
					Title = "Reset interface?",
					Content = "Scale, corners, font, colours and background go back to default.",
					ConfirmText = "Reset",
					Icon = "rotate-ccw",
					OnConfirm = function()
				controls.Scale:Set(defaults.Scale)
				controls.Radius:Set(defaults.Radius)
				controls.Font:Set(defaults.Font)
				local themeControls = Library.ThemeControls
				if themeControls then
					themeControls.Preset:Set(DefaultPreset)
					themeControls.Rotation:Set(45)
					for _, picker in pairs(themeControls.Theme) do
						picker:SetSpeed(1)
						if picker.Mode ~= "Static" then
							picker:SetMode("Static")
						end
					end
				else
					Library:ApplyPreset(DefaultPreset)
					Library:SetGradientRotation(45)
				end
				for _, element in pairs(Library.Elements) do
					if element.Type == "ColorPicker" and element.Mode ~= "Static" then
						element:SetSpeed(1)
						element:SetMode("Static")
					end
				end
				controls.Opacity:Set(defaults.Opacity)
				controls.Panels:Set(defaults.Panels)
				controls.Background:Set("")
				controls.Dim:Set(defaults.Dim)
				Library:Notify({ Title = "Interface reset", Content = "Scale, corners, font and colours are back to default.", Icon = "rotate-ccw" })
					end,
				})
			end,
		})
		panel:AddButton({
			Name = "Unload",
			Icon = "power",
			Callback = function()
				Library:Confirm({
					Title = "Unload Ascend?",
					Content = "This closes the hub and turns off every feature that is running. You will need to execute it again to get it back.",
					ConfirmText = "Unload",
					Icon = "power",
					Danger = true,
					OnConfirm = function()
						task.defer(function()
							Library:Unload()
						end)
					end,
				})
			end,
		})
		self.SettingsControls = controls
		return popover
	end

	function Tab:AddConfigSection(options)
		options = options or {}
		local section = self:AddSection({
			Name = options.Name or "Configs",
			Icon = options.Icon or "folder",
			Description = options.Description or "Save, load and share your setup",
			Toggle = false,
			Side = options.Side,
		})
		local storageLabel = section:AddLabel("")
		local nameBox = section:AddTextbox({
			Name = "Config name",
			Placeholder = "My setup",
			MaxLength = 32,
			Icon = "pencil",
		})
		local savedList = section:AddDropdown({
			Name = "Saved configs",
			Options = {},
			Placeholder = "None saved",
			Callback = function(name)
				if type(name) == "string" then
					nameBox:Set(name, true)
				end
			end,
		})
		local autoloadLabel = section:AddLabel("")

		local function selectedName()
			local typed = TrimText(nameBox:Get())
			if typed ~= "" then
				return typed
			end
			return savedList:Get()
		end

		local function refresh()
			local names, autoload = Library:ListConfigs()
			savedList:Refresh(names, true)
			if Library:GetConfigStorage() == "Files" then
				local _, folder = Library:_ConfigPaths()
				storageLabel:Set("Saving to the <b>" .. folder .. "</b> folder. Configs stay between sessions.")
			else
				storageLabel:Set("Saving for this session only. Use a share code to keep a setup between visits.")
			end
			if type(autoload) == "string" and autoload ~= "" then
				autoloadLabel:Set("Loads on join: <b>" .. autoload .. "</b>")
			else
				autoloadLabel:Set("Loads on join: nothing")
			end
		end

		local function report(ok, problem, successTitle, successText, icon)
			if ok then
				Library:Notify({ Title = successTitle, Content = successText, Type = "Success", Icon = icon })
			else
				Library:Notify({ Title = "That did not work", Content = tostring(problem or "Something went wrong."), Type = "Error" })
			end
		end

		section:AddButtons({
			{
				Name = "Save",
				Icon = "save",
				Callback = function()
					local name = selectedName()
					local ok, problem = Library:SaveConfigAs(name)
					report(ok, problem, "Config saved", tostring(name) .. " has your current settings.", "save")
					refresh()
				end,
			},
			{
				Name = "Load",
				Icon = "folder-open",
				Callback = function()
					local name = selectedName()
					local ok, problem = Library:LoadConfigNamed(name)
					report(ok, problem, "Config loaded", tostring(name) .. " is now active.", "folder-open")
				end,
			},
			{
				Name = "Delete",
				Icon = "trash-2",
				Callback = function()
					local name = selectedName()
					local function remove()
						local ok, problem = Library:DeleteConfig(name)
						report(ok, problem, "Config deleted", tostring(name) .. " was removed.", "trash-2")
						nameBox:Set("", true)
						refresh()
					end
					if type(name) ~= "string" or name == "" then
						remove()
						return
					end
					Library:Confirm({
						Title = "Delete " .. name .. "?",
						Content = "This config file will be removed for good. Your current settings stay as they are.",
						ConfirmText = "Delete",
						Icon = "trash-2",
						Danger = true,
						OnConfirm = remove,
					})
				end,
			},
		})
		section:AddButtons({
			{
				Name = "Load on join",
				Icon = "pin",
				Callback = function()
					local name = selectedName()
					local ok, problem = Library:SetAutoloadConfig(name)
					report(ok, problem, "Autoload set", tostring(name) .. " will load when you join.", "pin")
					refresh()
				end,
			},
			{
				Name = "Clear",
				Icon = "pin-off",
				Callback = function()
					Library:SetAutoloadConfig(nil)
					refresh()
				end,
			},
			{
				Name = "Refresh",
				Icon = "refresh-cw",
				Callback = refresh,
			},
		})
		section:AddDivider()
		local shareBox = section:AddTextbox({
			Name = "Share code",
			Placeholder = "Paste a code here, then press Import",
			Icon = "copy",
		})
		section:AddLabel({ Text = "To copy a code: click the box, press Ctrl + A, then Ctrl + C.", Color = Theme.TextFaint })
		section:AddButtons({
			{
				Name = "Export",
				Icon = "copy",
				Callback = function()
					shareBox:Set(Library:ExportConfig(), true)
					Library:Notify({ Title = "Code ready", Content = "Your share code is in the box. Copy it to keep it.", Icon = "copy" })
				end,
			},
			{
				Name = "Import",
				Icon = "download",
				Callback = function()
					local ok = Library:ImportConfig(shareBox:Get())
					report(ok, "That code could not be read. Check you copied all of it.", "Code imported", "Settings from the code are now active.", "download")
				end,
			},
		})
		refresh()
		table.insert(Library.ConfigSections, refresh)
		task.defer(function()
			Library:_RunAutoload()
			refresh()
			if Library.AutosaveName then
				Library:QueueAutosave()
			end
		end)
		section.Refresh = refresh
		return section
	end

	local TabHeight = 34

	local function SetTabShown(tab, shown, instant)
		if tab.Shown == shown then
			return
		end
		tab.Shown = shown
		local button = tab.Button
		if tab.ShowTween then
			tab.ShowTween:Cancel()
			tab.ShowTween = nil
		end
		button.ClipsDescendants = true
		if instant then
			button.Size = UDim2.new(1, 0, 0, shown and TabHeight or 0)
			button.Visible = shown
			return
		end
		if shown then
			button.Visible = true
			tab.ShowTween = Tween(button, { Size = UDim2.new(1, 0, 0, TabHeight) }, Motion.Base)
		else
			tab.ShowTween = Tween(button, { Size = UDim2.new(1, 0, 0, 0) }, Motion.Base)
			if tab.ShowTween then
				tab.ShowTween.Completed:Connect(function(state)
					if state == Enum.PlaybackState.Completed and not tab.Shown then
						button.Visible = false
					end
				end)
			else
				button.Visible = false
			end
		end
	end

	function Window:_RefreshCategory(category, instant)
		for _, tab in ipairs(category.Tabs) do
			SetTabShown(tab, not category.Collapsed or tab.Active == true, instant)
		end
		Tween(category.Chevron, { Rotation = category.Collapsed and -90 or 0 }, instant and 0 or Motion.Base)
	end

	function Window:SetCategoryCollapsed(name, collapsed)
		for _, category in ipairs(self.Categories) do
			if category.Name == name then
