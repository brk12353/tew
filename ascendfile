	function Section:AddTextbox(options)
		options = options or {}
		local name = tostring(options.Name or "Text")
		local textbox = {
			Type = "Textbox",
			Name = name,
			Flag = options.Flag,
			Callback = options.Callback,
			Value = tostring(options.Default or ""),
		}

		local holder = BuildTile(self, 66, "Frame")
		local title = Text({
			Position = UDim2.fromOffset(10, 6),
			Text = name,
			Size = UDim2.new(1, -20, 0, 20),
			TextColor3 = Theme.TextDim,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Parent = holder,
		})
		local box = Create("Frame", {
			Position = UDim2.fromOffset(8, 30),
			Size = UDim2.new(1, -16, 0, 30),
			BackgroundColor3 = Theme.Raised,
			Parent = holder,
		})
		Round(box, 7)
		local stroke = Stroke(box, Theme.Line)
		local _, tintIcon = Glyph(box, { options.Icon or "text-cursor-input", "type" }, 14, Theme.TextFaint, nil, {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 9, 0.5, 0),
		})
		local input = Create("TextBox", {
			Position = UDim2.fromOffset(29, 0),
			Size = UDim2.new(1, -38, 1, 0),
			BackgroundTransparency = 1,
			Text = textbox.Value,
			PlaceholderText = tostring(options.Placeholder or ""),
			PlaceholderColor3 = Theme.TextFaint,
			TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left,
			ClearTextOnFocus = options.ClearOnFocus == true,
			ClipsDescendants = true,
			Parent = box,
		})

		local maxLength = tonumber(options.MaxLength)
		input:GetPropertyChangedSignal("Text"):Connect(function()
			local text = input.Text
			if options.Numeric then
				text = string.gsub(text, "[^%d%.%-]", "")
			end
			if maxLength and #text > maxLength then
				text = string.sub(text, 1, maxLength)
			end
			if text ~= input.Text then
				input.Text = text
			end
		end)
		HoverTile(holder)
		input.Focused:Connect(function()
			Tween(stroke, { Color = Theme.Accent }, Motion.Fast)
			Tween(title, { TextColor3 = Theme.Text }, Motion.Fast)
			tintIcon(Theme.Accent)
		end)
		input.FocusLost:Connect(function(enterPressed)
			Tween(stroke, { Color = Theme.Line }, Motion.Fast)
			Tween(title, { TextColor3 = Theme.TextDim }, Motion.Fast)
			tintIcon(Theme.TextFaint)
			textbox.Value = input.Text
			SetFlag(textbox)
			SafeCall(textbox.Callback, textbox.Value, enterPressed)
		end)

		function textbox:Set(text, silent)
			self.Value = tostring(text or "")
			input.Text = self.Value
			SetFlag(self)
			if not silent then
				SafeCall(self.Callback, self.Value, false)
			end
		end

		function textbox:Get()
			return self.Value
		end

		RegisterElement(textbox)
		AttachTooltip(title, options.Tooltip)
		AttachLock(textbox, holder)
		self:_Register(name, holder)
		return textbox
	end

