		if isModule then
			local module = BuildToggle(header, {
				Name = section.Name,
				Flag = moduleOptions.Flag,
				Callback = moduleOptions.Callback,
				Default = moduleOptions.Default ~= false,
			}, nil, function(on, instant)
				local duration = instant and 0 or Motion.Base
				Tween(titleLabel, { TextColor3 = on and Theme.Text or Theme.TextDim }, duration)
				tintBadge(on and Theme.Accent or Theme.TextFaint, duration)
			end)
			section.Module = module
			module.OnChanged = function()
				section:_RefreshLive(false)
			end
			local keybindOptions = moduleOptions.Keybind
			if type(keybindOptions) ~= "table" then
				keybindOptions = { Default = keybindOptions }
			end
			if keybindOptions.Flag == nil and moduleOptions.Flag then
				keybindOptions.Flag = moduleOptions.Flag .. "Key"
			end
			module:AddKeybind(keybindOptions)
			blocker.Activated:Connect(function()
				if module.Switch then
