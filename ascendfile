		local closed = false
		local pinned = false
		local hovering = false
		local remaining = duration
		local function dismiss(fast)
			if closed then
				return
			end
			closed = true
			local speed = fast and 0.09 or Motion.Base
			Tween(card, { Position = hiddenOffset(fast), GroupTransparency = 1 }, speed, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			if animation == "Pop" then
				Tween(cardScale, { Scale = 0.9 }, speed, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			end
			task.wait(speed)
			Tween(wrapper, { Size = UDim2.new(1, 0, 0, 0) }, fast and 0.12 or Motion.Base, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut)
			task.wait((fast and 0.12 or Motion.Base) + 0.02)
			wrapper:Destroy()
		end
		local function renderPin()
			Tween(pinButton, { BackgroundColor3 = pinned and color or Theme.Hover, BackgroundTransparency = pinned and 0.8 or 1 }, Motion.Fast)
			tintPin(pinned and color or Theme.TextFaint)
			Tween(track, { BackgroundTransparency = pinned and 1 or 0 }, Motion.Fast)
			Tween(fill, { BackgroundTransparency = pinned and 1 or 0 }, Motion.Fast)
		end
		hit.Activated:Connect(function()
			if pinned then
				Tween(pinButton, { BackgroundTransparency = 0.55 }, 0.08)
				task.delay(0.1, function()
					if not closed then
						renderPin()
					end
				end)
				return
			end
			task.spawn(dismiss, true)
		end)
		hit.MouseEnter:Connect(function()
			hovering = true
			Tween(hit, { BackgroundTransparency = 0.5 }, Motion.Fast)
		end)
		hit.MouseLeave:Connect(function()
			hovering = false
			Tween(hit, { BackgroundTransparency = 1 }, Motion.Fast)
		end)
		closeButton.Activated:Connect(function()
			task.spawn(dismiss, true)
		end)
		closeButton.MouseEnter:Connect(function()
			hovering = true
			Tween(closeButton, { BackgroundTransparency = 0 }, Motion.Fast)
			tintClose(Theme.Text)
		end)
		closeButton.MouseLeave:Connect(function()
			hovering = false
			Tween(closeButton, { BackgroundTransparency = 1 }, Motion.Fast)
			tintClose(Theme.TextFaint)
		end)
		pinButton.Activated:Connect(function()
			pinned = not pinned
			renderPin()
		end)
		pinButton.MouseEnter:Connect(function()
			hovering = true
			if not pinned then
				Tween(pinButton, { BackgroundTransparency = 0 }, Motion.Fast)
				tintPin(Theme.Text)
			end
		end)
		pinButton.MouseLeave:Connect(function()
			hovering = false
			renderPin()
		end)
		AttachTooltip(pinButton, "Pin to keep it on screen")

		local handle = {}
		function handle:Dismiss()
			task.spawn(dismiss, true)
		end
		function handle:SetPinned(state)
			pinned = state == true
			renderPin()
		end

		task.spawn(function()
			local tries = 0
			repeat
				RunService.Heartbeat:Wait()
				tries += 1
			until (body.AbsoluteSize.Y > 0 and tries >= 2) or tries > 15
			if not card.Parent then
				return
			end
			local height = body.AbsoluteSize.Y + 2
			card.Size = UDim2.new(1, 0, 0, height)
			Tween(wrapper, { Size = UDim2.new(1, 0, 0, height) }, Motion.Base)
			Tween(card, { Position = UDim2.fromOffset(0, 0), GroupTransparency = 0 }, Motion.Slow)
			if animation == "Pop" then
				Tween(cardScale, { Scale = 1 }, Motion.Slow, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
			end
			while not closed and card.Parent do
				local deltaTime = RunService.Heartbeat:Wait()
				if not pinned and not hovering then
					remaining -= deltaTime
					fill.Size = UDim2.fromScale(math.max(remaining / duration, 0), 1)
					if remaining <= 0 then
						dismiss(false)
					end
				end
			end
		end)
		return handle
	end

	local function EncodePosition(object)
		if not object then
			return nil
		end
		local position = object.Position
		return { position.X.Scale, position.X.Offset, position.Y.Scale, position.Y.Offset }
	end

	local function DecodePosition(value)
		if type(value) ~= "table" then
			return nil
		end
		local xs, xo, ys, yo = tonumber(value[1]), tonumber(value[2]), tonumber(value[3]), tonumber(value[4])
		if xs and xo and ys and yo then
			return UDim2.new(xs, xo, ys, yo)
		end
		return nil
	end

	function Library:_GetLayout()
		local window = self.Window
		local layout = {
			Watermark = EncodePosition(self.Watermark),
			KeybindList = EncodePosition(self.KeybindList),
			Panels = {},
		}
		for id, panel in pairs(self.Panels or {}) do
			layout.Panels[id] = EncodePosition(panel.Frame)
		end
		if window then
			if window.Dragged then
				layout.Window = EncodePosition(window.Shell)
			end
			layout.Bubble = EncodePosition(window.Bubble)
			layout.Tab = window.ActiveTab and window.ActiveTab.Name or nil
			layout.Minimized = window.Minimized
			layout.Folded = {}
			for _, tab in ipairs(window.Tabs) do
				for _, section in ipairs(tab.Sections) do
					if section.Clip and not section.Expanded then
						table.insert(layout.Folded, tab.Name .. "/" .. section.Name)
					end
				end
			end
		end
		return layout
	end

	function Library:_ApplyLayout(layout)
		if type(layout) ~= "table" then
			return
		end
		local watermarkPosition = DecodePosition(layout.Watermark)
		if watermarkPosition and self.Watermark then
			Tween(self.Watermark, { Position = watermarkPosition }, Motion.Slow)
		end
		local keybindPosition = DecodePosition(layout.KeybindList)
		if keybindPosition and self.KeybindList then
			Tween(self.KeybindList, { Position = keybindPosition }, Motion.Slow)
		end
		if type(layout.Panels) == "table" then
			self.PendingPanelLayout = layout.Panels
			for id, value in pairs(layout.Panels) do
				local panel = self.Panels and self.Panels[id]
				local position = DecodePosition(value)
				if panel and position then
					Tween(panel.Frame, { Position = position }, Motion.Slow)
				end
			end
		end
		local window = self.Window
		if not window then
			return
		end
		local windowPosition = DecodePosition(layout.Window)
		if windowPosition then
			window.Dragged = true
			Tween(window.Shell, { Position = windowPosition }, Motion.Slow)
		end
		local bubblePosition = DecodePosition(layout.Bubble)
		if bubblePosition then
			window.Bubble.Position = bubblePosition
		end
		if type(layout.Tab) == "string" then
			window:SelectTab(layout.Tab)
		end
		if type(layout.Minimized) == "boolean" and layout.Minimized ~= window.Minimized then
			window:SetMinimized(layout.Minimized)
		end
		if type(layout.Folded) == "table" then
			local folded = {}
			for _, key in ipairs(layout.Folded) do
				folded[tostring(key)] = true
			end
			for _, tab in ipairs(window.Tabs) do
				for _, section in ipairs(tab.Sections) do
					if section.Clip then
						local shouldExpand = not folded[tab.Name .. "/" .. section.Name]
						if section.Expanded ~= shouldExpand then
							section:_SetExpanded(shouldExpand, false)
						end
					end
				end
			end
		end
	end

	function Library:GetConfig()
		local data = {}
		for flag, element in pairs(self.Elements) do
			local value = element.Value
			if element.Type == "ColorPicker" then
				data[flag] = { Type = "Color", Value = (element.BaseValue or value):ToHex(), Mode = element.Mode, Speed = element.Speed }
			elseif element.Type == "Keybind" then
				local inputType = "KeyCode"
				if value ~= nil and value.EnumType ~= Enum.KeyCode then
					inputType = "UserInputType"
				end
				data[flag] = {
					Type = "Keybind",
					Value = value and value.Name or "None",
					Input = inputType,
					Mode = element.Mode,
					Modifiers = table.clone(element.Modifiers),
				}
			else
				data[flag] = { Type = element.Type, Value = CloneValue(value) }
			end
		end
		data.__Layout = { Type = "Layout", Value = self:_GetLayout() }
		local extra = {}
		for key, provider in pairs(self.ConfigData) do
			local ok, value = pcall(provider.Get)
			if ok and value ~= nil then
				extra[key] = value
			end
		end
		if next(extra) ~= nil then
			data.__Data = { Type = "Data", Value = extra }
		end
		return HttpService:JSONEncode(data)
	end

	function Library:AddConfigData(key, getter, setter)
		if type(key) == "string" and type(getter) == "function" and type(setter) == "function" then
			self.ConfigData[key] = { Get = getter, Set = setter }
		end
	end

	function Library:EnableAutosave(name)
		self.AutosaveName = tostring(name or "Autosave")
	end

	function Library:FlushAutosave()
		if not self.AutosaveName or self.Unloaded then
			return false
		end
		self.AutosaveQueued = false
		local before = table.find((self:ListConfigs()), self.AutosaveName) ~= nil
		local ok = self:_ConfigCall("Save", self.AutosaveName, self:GetConfig())
		if ok and not before then
			for _, refresh in ipairs(self.ConfigSections) do
				pcall(refresh)
			end
		end
		return ok
	end

	function Library:QueueAutosave()
		if not self.AutosaveName or self.LoadingConfig or self.Unloaded or not self.AutoloadDone then
			return
		end
		self.AutosaveQueued = true
		self.AutosaveDeadline = os.clock() + 1.5
		if self.AutosaveWaiting then
			return
		end
		self.AutosaveWaiting = true
		task.spawn(function()
			while self.AutosaveQueued and not self.Unloaded and os.clock() < self.AutosaveDeadline do
				task.wait(math.max(self.AutosaveDeadline - os.clock(), 0.05))
			end
			self.AutosaveWaiting = false
			if self.AutosaveQueued and not self.Unloaded then
				self:FlushAutosave()
			end
		end)
	end

	Library.SaveConfig = Library.GetConfig

	function Library:LoadConfig(json)
		if type(json) ~= "string" or json == "" then
			return false
		end
		local ok, data = pcall(HttpService.JSONDecode, HttpService, json)
		if not ok or type(data) ~= "table" then
			return false
		end
		if type(data.__Layout) == "table" then
			local layout = data.__Layout.Value
			task.defer(function()
				self:_ApplyLayout(layout)
			end)
		end
		self.LoadingConfig = true
		for flag, entry in pairs(data) do
			local element = self.Elements[flag]
			if element and type(entry) == "table" then
				if entry.Type == "Color" then
					local parsed, color = pcall(Color3.fromHex, tostring(entry.Value))
					if parsed then
						element:Set(color)
					end
					if element.SetSpeed and tonumber(entry.Speed) then
						element:SetSpeed(tonumber(entry.Speed))
					end
					if element.SetMode and type(entry.Mode) == "string" then
						element:SetMode(entry.Mode)
					end
				elseif entry.Type == "Keybind" then
					if type(entry.Mode) == "string" then
						element:SetMode(entry.Mode)
					end
					if entry.Value == "None" then
						element:Set(nil)
					else
						local enum = entry.Input == "UserInputType" and Enum.UserInputType or Enum.KeyCode
						local found, item = pcall(function()
							return enum[entry.Value]
						end)
						if found and item then
							element:Set(item, false, entry.Modifiers)
						end
					end
				else
					pcall(element.Set, element, entry.Value)
				end
			end
		end
		if type(data.__Data) == "table" and type(data.__Data.Value) == "table" then
			for key, value in pairs(data.__Data.Value) do
				local provider = self.ConfigData[key]
				if provider then
					pcall(provider.Set, value)
				end
			end
		end
		self.LoadingConfig = false
		self:QueueAutosave()
		return true
	end

	local function TrimText(value)
		local text = tostring(value or "")
		text = string.gsub(text, "^%s+", "")
		text = string.gsub(text, "%s+$", "")
		return text
	end

	local function ValidConfigName(name)
		local text = TrimText(name)
		if text == "" then
			return nil, "Type a name for the config first."
		end
		if #text > 32 then
			return nil, "Config names can be up to 32 characters."
		end
		if not string.match(text, "^[%w _%-]+$") then
			return nil, "Use letters, numbers, spaces, dashes or underscores."
		end
		return text
	end

	local function FileApi()
		local api = {}
		pcall(function()
			api.Write = writefile
			api.Read = readfile
			api.IsFile = isfile
			api.List = listfiles
			api.MakeFolder = makefolder
			api.IsFolder = isfolder
			api.Delete = delfile
		end)
		local required = { api.Write, api.Read, api.IsFile, api.List, api.MakeFolder, api.IsFolder }
		for index = 1, 6 do
			if type(required[index]) ~= "function" then
				return nil
			end
		end
		return api
	end

	function Library:_ConfigPaths()
		local root = tostring(self.ConfigFolder or "Ascend")
		return root, root .. "/configs", root .. "/autoload.txt"
	end

	function Library:_EnsureFolders(api)
		local root, configs = self:_ConfigPaths()
		local ok = pcall(function()
			if not api.IsFolder(root) then
				api.MakeFolder(root)
			end
			if not api.IsFolder(configs) then
				api.MakeFolder(configs)
			end
		end)
		return ok
	end

	function Library:GetConfigStorage()
		if FileApi() then
			return "Files"
		end
		return "Session"
	end

	local FileBackend = {}

	function FileBackend.List(api, folder, autoloadPath)
		local names = {}
		local ok = pcall(function()
			for _, file in ipairs(api.List(folder)) do
				local configName = string.match(tostring(file), "([^/\\]+)%.json$")
				if configName then
					table.insert(names, configName)
				end
			end
		end)
		if not ok then
			return false, "Could not read the config folder."
		end
		table.sort(names)
		local autoload = nil
		pcall(function()
			if api.IsFile(autoloadPath) then
				local stored = api.Read(autoloadPath)
				if type(stored) == "string" and stored ~= "" and api.IsFile(folder .. "/" .. stored .. ".json") then
					autoload = stored
				end
			end
		end)
		return true, { Names = names, Autoload = autoload }
	end

	function FileBackend.Save(api, _, _, path, _, data)
		local ok, problem = pcall(api.Write, path, data)
		if not ok then
			return false, "Could not write the file: " .. tostring(problem)
		end
		return true, nil
	end

	function FileBackend.Load(api, _, _, path)
		local ok, stored = pcall(function()
			if api.IsFile(path) then
				return api.Read(path)
			end
			return nil
		end)
		if ok and type(stored) == "string" then
			return true, stored
		end
		return false, "That config does not exist."
	end

	function FileBackend.Delete(api, _, autoloadPath, path, name)
		local ok = pcall(function()
			if api.Delete then
				api.Delete(path)
			else
				api.Write(path, "")
			end
		end)
		if not ok then
			return false, "Could not delete that file."
		end
		pcall(function()
			if api.IsFile(autoloadPath) and api.Read(autoloadPath) == name then
				api.Write(autoloadPath, "")
			end
		end)
		return true, nil
	end

	function FileBackend.SetAutoload(api, _, autoloadPath, _, name)
		local ok = pcall(api.Write, autoloadPath, name or "")
		if not ok then
			return false, "Could not save the autoload choice."
		end
		return true, nil
	end

	local MemoryBackend = {}

	function MemoryBackend.List(memory)
		local names = {}
		for configName in pairs(memory.Configs) do
			table.insert(names, configName)
		end
		table.sort(names)
		return true, { Names = names, Autoload = memory.Autoload }
	end

	function MemoryBackend.Save(memory, name, data)
		memory.Configs[name] = data
		return true, nil
	end

	function MemoryBackend.Load(memory, name)
		local stored = memory.Configs[name]
		if stored then
			return true, stored
		end
		return false, "That config does not exist."
	end

	function MemoryBackend.Delete(memory, name)
		memory.Configs[name] = nil
		if memory.Autoload == name then
			memory.Autoload = nil
		end
		return true, nil
	end

	function MemoryBackend.SetAutoload(memory, name)
		memory.Autoload = name
		return true, nil
	end

	function Library:_ConfigCall(action, name, data)
		local api = FileApi()
		if api then
			local handler = FileBackend[action]
			if not handler then
				return false, "Unknown action."
			end
			if not self:_EnsureFolders(api) then
				return false, "Could not create the config folder."
			end
			local _, folder, autoloadPath = self:_ConfigPaths()
			local path = name and (folder .. "/" .. name .. ".json") or nil
			return handler(api, folder, autoloadPath, path, name, data)
		end
		local handler = MemoryBackend[action]
		if not handler then
			return false, "Unknown action."
		end
		return handler(self.SessionConfigs, name, data)
	end

	function Library:ListConfigs()
		local ok, result = self:_ConfigCall("List")
		if ok and type(result) == "table" then
			return result.Names or {}, result.Autoload
		end
		return {}, nil
	end

	function Library:SaveConfigAs(name)
		local valid, problem = ValidConfigName(name)
		if not valid then
			return false, problem
		end
		return self:_ConfigCall("Save", valid, self:GetConfig())
	end

	function Library:LoadConfigNamed(name)
		local valid, problem = ValidConfigName(name)
		if not valid then
			return false, problem
		end
		local ok, data = self:_ConfigCall("Load", valid)
		if ok and type(data) == "string" then
			return self:LoadConfig(data), nil
		end
		return false, data
	end

	function Library:DeleteConfig(name)
		local valid, problem = ValidConfigName(name)
		if not valid then
			return false, problem
		end
		return self:_ConfigCall("Delete", valid)
	end

	function Library:SetAutoloadConfig(name)
		if name == nil then
			return self:_ConfigCall("SetAutoload", nil)
		end
		local valid, problem = ValidConfigName(name)
		if not valid then
			return false, problem
		end
		return self:_ConfigCall("SetAutoload", valid)
	end

	function Library:ExportConfig()
		return "ASCEND:" .. self:GetConfig()
	end

	function Library:ImportConfig(code)
		local text = TrimText(code)
		text = string.gsub(text, "^ASCEND:", "")
		if text == "" then
			return false
		end
		return self:LoadConfig(text)
	end

	function Library:_RunAutoload()
		if self.AutoloadDone then
			return
		end
		self.AutoloadDone = true
		local autoload = nil
		for attempt = 1, 5 do
			local ok, result = self:_ConfigCall("List")
			if ok and type(result) == "table" then
				autoload = result.Autoload
				break
			end
			task.wait(attempt)
		end
		if type(autoload) == "string" and autoload ~= "" then
			local ok = self:LoadConfigNamed(autoload)
			if ok then
				self:Notify({ Title = "Config loaded", Content = autoload .. " was loaded automatically.", Type = "Success", Icon = "folder-open" })
			end
		elseif self.AutosaveName and table.find((self:ListConfigs()), self.AutosaveName) then
			self:LoadConfigNamed(self.AutosaveName)
		end
	end

	function Library:SetRadius(radius)
		Theme.Radius = math.clamp(tonumber(radius) or 4, 0, 12)
		PruneRegistry(CornerRegistry)
		for corner, desired in pairs(CornerRegistry) do
			corner.CornerRadius = UDim.new(0, CornerSize(desired))
		end
	end

	function Library:SetFont(name)
		local choice = nil
		for _, candidate in ipairs(FontChoices) do
			if candidate.Name == name then
				choice = candidate
				break
			end
		end
		if not choice then
			return false
		end
		local family = choice.Family or ResolveFamily(function()
			return Enum.Font[choice.Enum]
		end, nil)
		if not family then
			return false
		end
		self.FontName = choice.Name
		Fonts.Regular = Font.new(family, Enum.FontWeight.Regular)
		Fonts.Medium = Font.new(family, Enum.FontWeight.Medium)
		Fonts.SemiBold = Font.new(family, Enum.FontWeight.SemiBold)
		Fonts.Bold = Font.new(family, Enum.FontWeight.Bold)
		PruneRegistry(TextRegistry)
		for object in pairs(TextRegistry) do
			if object.Parent then
				local current = object.FontFace
				object.FontFace = Font.new(family, current.Weight, current.Style)
			end
		end
		return true
	end

	function Library:SetWindowOpacity(opacity)
		local window = self.Window
		if not window then
			return
		end
		window.Opacity = math.clamp(tonumber(opacity) or 1, 0.2, 1)
		window.Canvas.BackgroundTransparency = 1 - window.Opacity
		if window.SettingsPopover then
			window.SettingsPopover.Frame.BackgroundTransparency = 1 - window.Opacity
		end
		self:_ApplyOverlayOpacity()
	end

	function Library:_OverlayTransparency()
		local window = self.Window
		return 1 - ((window and window.Opacity) or 1)
	end

	function Library:_ApplyOverlayOpacity()
		local transparency = self:_OverlayTransparency()
		local window = self.Window
		local targets = { self.Watermark, self.KeybindList, window and window.Bubble }
		for index = 1, 3 do
			local target = targets[index]
			if target then
				target.BackgroundTransparency = transparency
			end
		end
		if self.NotificationHolder then
			for _, card in ipairs(self.NotificationHolder:GetDescendants()) do
				if card:IsA("CanvasGroup") then
					card.BackgroundTransparency = transparency
				end
			end
		end
	end

	function Library:SetPanelOpacity(opacity)
		self.PanelOpacity = math.clamp(tonumber(opacity) or 1, 0, 1)
		PruneRegistry(PanelRegistry)
		for panel in pairs(PanelRegistry) do
			if panel.Parent then
				panel.BackgroundTransparency = 1 - self.PanelOpacity
			end
		end
	end

	function Library:SetBackgroundDim(amount)
		local window = self.Window
		if not window then
			return
		end
		window.BackdropDim.BackgroundTransparency = 1 - math.clamp(tonumber(amount) or 0.55, 0, 1)
	end

	function Library:SetBackground(value)
		local window = self.Window
		if not window then
			return false
		end
		local backdrop = window.Backdrop
		local text = TrimText(value)
		window.BackdropToken = (window.BackdropToken or 0) + 1
		local token = window.BackdropToken
		if text == "" then
			backdrop.Visible = false
			backdrop.Image = ""
			return true
		end
		local lower = string.lower(text)
		if string.find(lower, "http", 1, true) and not string.find(lower, "roblox.com", 1, true) then
			self:Notify({
				Title = "Image link not supported",
				Content = "Roblox only shows images uploaded to Roblox. Upload the picture as a Decal, then paste its ID here.",
				Type = "Warning",
				Duration = 6,
				Icon = "image",
			})
			return false
		end
		local image = nil
		local id = string.match(text, "(%d+)")
		if string.find(lower, "rbxasset", 1, true) or string.find(lower, "rbxthumb", 1, true) then
			image = text
		elseif id then
			image = "rbxassetid://" .. id
		end
		if not image then
			self:Notify({ Title = "No image ID found", Content = "Paste a Roblox image or decal ID, like 1234567890.", Type = "Warning", Icon = "image" })
			return false
		end
		backdrop.Image = image
		backdrop.Visible = true
		if id and not string.find(lower, "rbxthumb", 1, true) then
			task.delay(2.5, function()
				if window.BackdropToken == token and backdrop.Parent and not backdrop.IsLoaded then
					backdrop.Image = "rbxthumb://type=Asset&id=" .. id .. "&w=768&h=432"
				end
			end)
		end
		return true
	end

	local function AssetLoader()
		local loader = nil
		pcall(function()
			loader = getcustomasset or getsynasset
		end)
		if type(loader) == "function" then
			return loader
		end
		return nil
	end

	function Library:GetBackgroundFolder()
		local root = self:_ConfigPaths()
		return root .. "/backgrounds"
	end

	function Library:CanPickImageFiles()
		return FileApi() ~= nil and AssetLoader() ~= nil
	end

	function Library:FindBackgroundImages()
		local api = FileApi()
		local results = {}
		if not api or not AssetLoader() then
			return results
		end
		local root = self:_ConfigPaths()
		local folder = self:GetBackgroundFolder()
		pcall(function()
			if not api.IsFolder(root) then
				api.MakeFolder(root)
			end
			if not api.IsFolder(folder) then
				api.MakeFolder(folder)
			end
		end)
		local ok, files = pcall(api.List, folder)
		if not ok or type(files) ~= "table" then
			return results
		end
		local used = {}
		for _, file in ipairs(files) do
			local path = tostring(file)
			local fileName = string.match(path, "([^/\\]+)$") or path
			local extension = string.match(string.lower(fileName), "%.(%w+)$")
			if extension and ImageExtensions[extension] and not used[fileName] then
				used[fileName] = true
				table.insert(results, { Name = fileName, Path = path })
			end
		end
		table.sort(results, function(a, b)
			return string.lower(a.Name) < string.lower(b.Name)
		end)
		return results
	end

	function Library:SetBackgroundFile(path)
		local window = self.Window
		local loader = AssetLoader()
		if not window or not loader then
			self:Notify({
				Title = "Image files unavailable",
				Content = "This environment cannot load image files. Paste a Roblox image ID instead.",
				Type = "Warning",
				Icon = "image",
			})
			return false
		end
		local ok, asset = pcall(loader, path)
		if not ok or type(asset) ~= "string" or asset == "" then
			self:Notify({ Title = "Could not load that image", Content = tostring(path), Type = "Error", Icon = "image" })
			return false
		end
		window.BackdropToken = (window.BackdropToken or 0) + 1
		window.Backdrop.Image = asset
		window.Backdrop.Visible = true
		return true
	end

	function Library:Track(item)
		local kind = typeof(item)
		if kind == "RBXScriptConnection" or kind == "Instance" or kind == "function" or kind == "thread" then
			table.insert(self.Cleanups, item)
		elseif kind == "table" and (type(item.Disconnect) == "function" or type(item.Destroy) == "function") then
			table.insert(self.Cleanups, item)
		end
		return item
	end

	function Library:OnUnload(callback)
		if type(callback) == "function" then
			table.insert(self.Cleanups, callback)
		end
		return callback
	end

	function Library:Connect(signal, callback)
		return self:Track(signal:Connect(callback))
	end

	function Library:Unload()
		self:Destroy()
	end

	function Library:_RunCleanups()
		for _, toggle in ipairs(self.AllToggles) do
			if toggle.Value and type(toggle.Callback) == "function" then
				pcall(toggle.Callback, false)
			end
		end
		table.clear(self.AllToggles)
		for _, keybind in ipairs(self.Keybinds) do
			if not keybind.Target and keybind.LastEmitted == true and type(keybind.Callback) == "function" then
				pcall(keybind.Callback, false)
			end
		end
		local cleanups = self.Cleanups
		self.Cleanups = {}
		for index = #cleanups, 1, -1 do
			local item = cleanups[index]
			local kind = typeof(item)
			pcall(function()
				if kind == "function" then
					item()
				elseif kind == "RBXScriptConnection" then
					item:Disconnect()
				elseif kind == "Instance" then
					item:Destroy()
				elseif kind == "thread" then
					task.cancel(item)
				elseif type(item.Disconnect) == "function" then
					item:Disconnect()
				else
					item:Destroy()
				end
			end)
		end
	end

	function Library:Destroy()
		if self.Unloaded then
			return
		end
		if self.AutosaveQueued then
			pcall(function()
				self:FlushAutosave()
			end)
		end
		if self.ActiveConfirm then
			self.ActiveConfirm(false)
		end
		self.Unloaded = true
		self:_RunCleanups()
		if self.ActiveBinder then
			pcall(function()
				self.ActiveBinder:_StopListening()
			end)
		end
		table.clear(self.AnimatedPickers)
		for _, connection in ipairs(self.Connections) do
			pcall(function()
				connection:Disconnect()
			end)
		end
		table.clear(self.Connections)
		table.clear(self.ThemeHooks)
		table.clear(self.Gradients)
		table.clear(self.Keybinds)
		table.clear(self.Elements)
		table.clear(self.Flags)
		table.clear(self.PopoverStack)
		if self.Window then
			self.Window.Destroyed = true
			self.Window = nil
		end
		if self.ScreenGui then
			self.ScreenGui:Destroy()
			self.ScreenGui = nil
		end
		self.Binding = false
		self.ActiveBinder = nil
	end

	local function RegisterElement(element)
		if element.Flag then
			Library.Elements[element.Flag] = element
			Library.Flags[element.Flag] = CloneValue(element.Value)
		end
	end

	local function SetFlag(element)
		if element.Flag then
			Library.Flags[element.Flag] = CloneValue(element.Value)
			Library:QueueAutosave()
		end
	end

	local function NewSection(fields)
		local section = setmetatable(fields, Section)
		section.Elements = {}
		section.Toggles = {}
		section.Binds = {}
		section.Children = {}
		section.Order = 0
		return section
	end

	local function BuildSwitch(parent, layoutOrder)
		local track = Create("TextButton", {
			Size = UDim2.fromOffset(34, 20),
			BackgroundColor3 = Theme.Raised,
			LayoutOrder = layoutOrder or 40,
			Parent = parent,
		})
		Pill(track)
		local stroke = Stroke(track, Theme.LineStrong)
		local knob = Create("Frame", {
			AnchorPoint = Vector2.new(0, 0.5),
			Position = UDim2.new(0, 3, 0.5, 0),
			Size = UDim2.fromOffset(14, 14),
			BackgroundColor3 = Theme.KnobOff,
			Parent = track,
		})
		Pill(knob)
		OnTheme(function()
			if knob.Position.X.Offset > 10 then
				knob.BackgroundColor3 = Theme.OnAccent
			end
		end)
		local function render(on, instant)
			if instant then
				track.BackgroundColor3 = on and Theme.Accent or Theme.Raised
				stroke.Color = on and Theme.Accent or Theme.LineStrong
				knob.Position = on and UDim2.new(0, 17, 0.5, 0) or UDim2.new(0, 3, 0.5, 0)
				knob.BackgroundColor3 = on and Theme.OnAccent or Theme.KnobOff
				return
			end
			local duration = Motion.Base
			if on then
				Tween(track, { BackgroundColor3 = Theme.Accent }, duration)
				Tween(stroke, { Color = Theme.Accent }, duration)
				Tween(knob, { Position = UDim2.new(0, 17, 0.5, 0), BackgroundColor3 = Theme.OnAccent }, duration)
			else
				Tween(track, { BackgroundColor3 = Theme.Raised }, duration)
				Tween(stroke, { Color = Theme.LineStrong }, duration)
				Tween(knob, { Position = UDim2.new(0, 3, 0.5, 0), BackgroundColor3 = Theme.KnobOff }, duration)
			end
		end
		return track, render
	end

	local KeybindMethods = {}
	KeybindMethods.__index = KeybindMethods

	function KeybindMethods:IsUsable()
		return self.Section == nil or self.Section:IsLive()
	end

	function KeybindMethods:IsActive()
		if not self:IsUsable() then
			return false
		end
		if self.Target then
			return self.Target.Value == true
		end
		if self.Mode == "Always" then
			return true
		end
		return self.Active == true
	end

	function KeybindMethods:_Emit()
		if self.Target then
			return
		end
		local effective = self:IsActive()
		if effective ~= self.LastEmitted then
			self.LastEmitted = effective
			SafeCall(self.Callback, effective)
		end
	end

	function KeybindMethods:_Toggle()
		if self.Target then
			self.Target:Set(not self.Target.Value)
		else
			self.Active = not self.Active
			self:_Emit()
		end
		self:_Flash()
		Library:_RefreshKeybindList()
	end

	function KeybindMethods:_Press()
		local target = self.Target
		if self.Mode == "Toggle" then
			if self.Trigger == "Press" then
				self:_Toggle()
			else
				self.Armed = true
				if self.ChipScale then
					Tween(self.ChipScale, { Scale = 0.9 }, Motion.Fast, Enum.EasingStyle.Quad)
					Tween(self.ChipStroke, { Color = Theme.Accent }, Motion.Fast)
				end
			end
			return
		end
		if target then
			target:Set(true)
		elseif self.Mode == "Hold" then
			self.Active = true
			self:_Emit()
		else
			SafeCall(self.Callback, true)
		end
		self:_Flash()
		Library:_RefreshKeybindList()
	end

	function KeybindMethods:_Release()
		if self.Mode == "Toggle" then
			if not self.Armed then
				return
			end
			self.Armed = false
			if self:IsUsable() then
				self:_Toggle()
			else
				self:_Flash()
			end
			return
		end
		if self.Mode ~= "Hold" then
			return
		end
		local target = self.Target
		if target then
			if target.Value then
				target:Set(false)
			end
		elseif self.Active then
			self.Active = false
			self:_Emit()
		end
		Library:_RefreshKeybindList()
	end

	function KeybindMethods:_Flash()
		local chip = self.Chip
		if not chip or not chip.Parent then
			return
		end
		Tween(self.ChipScale, { Scale = 0.9 }, 0.06, Enum.EasingStyle.Quad)
		Tween(self.ChipStroke, { Color = Theme.Accent }, 0.06)
		task.delay(0.09, function()
			Tween(self.ChipScale, { Scale = 1 }, Motion.Base)
			if not self.Listening then
				Tween(self.ChipStroke, { Color = Theme.Line }, Motion.Slow)
			end
		end)
	end

	function KeybindMethods:_RenderChip()
		if not self.Chip then
			return
		end
		local isMouse = self.Value ~= nil and self.Value.EnumType ~= Enum.KeyCode
		local isPad = IsGamepadKey(self.Value) or (self.Value == nil and self.Accept == "Gamepad")
		if self.KeyboardIcon then
			self.KeyboardIcon.Visible = not isMouse and not isPad
		end
		if self.MouseIcon then
			self.MouseIcon.Visible = isMouse
		end
		if self.GamepadIcon then
			self.GamepadIcon.Visible = isPad
		end
		if self.Listening then
			local held = HeldModifiers(nil)
			if #held > 0 then
				self.ChipLabel.Text = table.concat(held, " + ") .. " + ..."
			elseif self.Accept == "Gamepad" or (self.Accept ~= "Keyboard" and UsingGamepad()) then
				self.ChipLabel.Text = "Press a button"
			else
				self.ChipLabel.Text = "Press a key"
			end
			self.ChipLabel.TextColor3 = Theme.Accent
		else
			self.ChipLabel.Text = ComboText(self.Value, self.Modifiers)
			self.ChipLabel.TextColor3 = self.Value and Theme.TextDim or Theme.TextFaint
		end
	end

	function KeybindMethods:_StartListening()
		if Library.ActiveBinder and Library.ActiveBinder ~= self then
			Library.ActiveBinder:_StopListening()
		end
		Library:_CloseUnrelatedPopovers(self.Chip)
		Library.ActiveBinder = self
		Library.Binding = true
		self.Listening = true
		self.PendingModifier = nil
		self.ListenToken = (self.ListenToken or 0) + 1
		local listenToken = self.ListenToken
		task.delay(8, function()
			if self.Listening and self.ListenToken == listenToken then
				self:_StopListening()
			end
		end)
		self:_RenderChip()
		self.ChipStroke.Color = Theme.Accent
		if self.Pulse then
			self.Pulse:Cancel()
		end
		self.Pulse = TweenService:Create(self.ChipStroke, TweenInfo.new(0.55, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), {
			Transparency = 0.8,
		})
		self.Pulse:Play()
	end

	function KeybindMethods:_StopListening()
		self.Listening = false
		self.PendingModifier = nil
		self.CapturedAt = os.clock()
		if self.Pulse then
			self.Pulse:Cancel()
			self.Pulse = nil
		end
		self.ChipStroke.Transparency = 0
		Tween(self.ChipStroke, { Color = Theme.Line }, Motion.Base)
		self:_RenderChip()
		if Library.ActiveBinder == self then
			Library.ActiveBinder = nil
		end
		task.defer(function()
			if Library.ActiveBinder == nil then
				Library.Binding = false
			end
		end)
	end

	function KeybindMethods:_Assign(key, mods)
		mods = NormalizeMods(mods)
		if key ~= nil and self.Value == key and ModsEqual(self.Modifiers, mods) then
			key = nil
			mods = {}
		end
		local taken = {}
		if key ~= nil then
			for _, other in ipairs(Library.Keybinds) do
				if other ~= self and other.Value == key and ModsEqual(other.Modifiers, mods) then
					table.insert(taken, other)
				end
			end
		end
		if #taken == 0 then
			self:Set(key, false, mods)
			return
		end
		local names = {}
		for _, other in ipairs(taken) do
			table.insert(names, tostring(other.Name))
		end
		local combo = ComboText(key, mods)
		Library:Confirm({
			Title = combo .. " is already in use",
			Content = combo .. " is bound to " .. table.concat(names, ", ") .. ". Move it to " .. tostring(self.Name) .. "? " .. table.concat(names, ", ") .. " will be left without a key.",
			ConfirmText = "Move key",
			CancelText = "Keep old",
			Icon = "keyboard",
			OnConfirm = function()
				for _, other in ipairs(taken) do
					if other.Value == key and ModsEqual(other.Modifiers, mods) then
						other:Set(nil)
					end
				end
				self:Set(key, false, mods)
				Library:Notify({
					Title = "Keybind moved",
					Content = combo .. " now belongs to " .. tostring(self.Name) .. ".",
					Duration = 3,
					Icon = "keyboard",
				})
			end,
		})
	end

	function KeybindMethods:_CaptureBegan(input)
		local inputType = input.UserInputType
		if inputType == Enum.UserInputType.Keyboard then
			local key = input.KeyCode
			if key == Enum.KeyCode.Unknown then
				return
			end
			if key == Enum.KeyCode.Escape or key == Enum.KeyCode.Backspace or key == Enum.KeyCode.Delete then
				self.PendingModifier = nil
				self:_Assign(nil, {})
				self:_StopListening()
				return
			end
			if self.Accept == "Gamepad" then
				return
			end
			local modifier = ModifierOf(key)
			if modifier and self.AllowCombos then
				self.PendingModifier = key
				self:_RenderChip()
				return
			end
			local mods = self.AllowCombos and HeldModifiers(modifier) or {}
			self:_Assign(key, mods)
			self:_StopListening()
		elseif IsGamepadInput(input) then
			local key = input.KeyCode
			if self.Accept == "Keyboard" or not IsGamepadKey(key) then
				return
			end
			if key == Enum.KeyCode.ButtonStart or key == Enum.KeyCode.ButtonSelect then
				return
			end
			self:_Assign(key, {})
			self:_StopListening()
		elseif inputType == Enum.UserInputType.MouseButton2 or inputType == Enum.UserInputType.MouseButton3 then
			if self.Accept == "Gamepad" then
				return
			end
			local mods = self.AllowCombos and HeldModifiers(nil) or {}
			self:_Assign(inputType, mods)
			self:_StopListening()
		elseif inputType == Enum.UserInputType.MouseButton1 or inputType == Enum.UserInputType.Touch then
			self:_StopListening()
		end
	end

	function KeybindMethods:_CaptureEnded(input)
		if not self.Listening then
			return
		end
		if input.KeyCode == Enum.KeyCode.Escape then
			self.PendingModifier = nil
			self:_Assign(nil, {})
			self:_StopListening()
			return
		end
		if not self.PendingModifier then
			return
		end
		if ModifierOf(input.KeyCode) == nil then
			return
		end
		if #HeldModifiers(nil) == 0 then
			self:_Assign(input.KeyCode, {})
			self:_StopListening()
		else
			self:_RenderChip()
		end
	end

	function KeybindMethods:Set(key, silent, modifiers)
		if type(key) == "string" then
			key, modifiers = ParseBinding(key, modifiers)
		end
		if key ~= nil and typeof(key) ~= "EnumItem" then
			key = nil
		end
		if self.Mode == "Hold" and not self.Target and self.Active then
			self.Active = false
			self:_Emit()
		end
		self.Value = key
		self.Modifiers = key and NormalizeMods(modifiers) or {}
		local own = ModifierOf(key)
		if own then
			local filtered = {}
			for _, mod in ipairs(self.Modifiers) do
				if mod ~= own then
					table.insert(filtered, mod)
				end
			end
			self.Modifiers = filtered
		end
		self:_RenderChip()
		SetFlag(self)
		Library:_RefreshKeybindList()
		if not silent then
			SafeCall(self.ChangedCallback, key, table.clone(self.Modifiers))
		end
	end

	function KeybindMethods:Get()
		return self.Value, table.clone(self.Modifiers)
	end

	function KeybindMethods:GetText()
		return ComboText(self.Value, self.Modifiers)
	end

	function KeybindMethods:SetMode(mode)
		if mode ~= "Toggle" and mode ~= "Hold" and mode ~= "Always" then
			return
		end
		if self.Mode == "Hold" or mode == "Hold" then
			self.Armed = false
			if self.Target and self.Target.Value then
				self.Target:Set(false)
			elseif not self.Target then
				self.Active = false
			end
		end
		self.Mode = mode
		if mode == "Always" then
			if self.Target then
				self.Target:Set(true)
			end
		elseif not self.Target then
			self.Active = false
		end
		self:_Emit()
		if self.RenderModes then
			self.RenderModes()
		end
		Library:_RefreshKeybindList()
	end

	local function BuildKeybind(parent, layoutOrder, options, target, section)
		options = options or {}
		local key, mods = ParseBinding(options.Default, options.Modifiers)
		local mode = options.Mode
		if mode ~= "Hold" and mode ~= "Always" then
			mode = "Toggle"
		end
		local keybind = setmetatable({
			Type = "Keybind",
			Name = tostring(options.Name or (target and target.Name) or "Keybind"),
			Flag = options.Flag,
			Callback = options.Callback,
			ChangedCallback = options.ChangedCallback,
			Mode = mode,
			Value = key,
			Modifiers = mods,
			Active = false,
			Listening = false,
			Target = target,
			Section = section,
			AllowCombos = options.Combos ~= false and Library.AllowCombos ~= false,
			Trigger = options.Trigger == "Press" and "Press" or "Release",
			ShowInList = options.ShowInList ~= false,
			Accept = (options.Accept == "Keyboard" or options.Accept == "Gamepad") and options.Accept or nil,
			CapturedAt = 0,
