		keybind.RenderModes = function()
			for name, row in pairs(modeRows) do
				local selected = keybind.Mode == name
				Tween(row.Label, { TextColor3 = selected and Theme.Text or Theme.TextDim }, Motion.Fast)
				row.Tint(selected and Theme.Accent or Theme.TextFaint)
				Tween(row.Button, {
					BackgroundColor3 = selected and Theme.Accent or Theme.Tile,
					BackgroundTransparency = selected and 0.86 or 1,
				}, Motion.Fast)
			end
		end
		keybind.RenderModes()
		OnTheme(function()
			keybind.RenderModes()
		end)

		chip.MouseEnter:Connect(function()
			if not keybind.Listening then
				Tween(chip, { BackgroundColor3 = Theme.Hover }, Motion.Fast)
				Tween(chipStroke, { Color = Theme.LineStrong }, Motion.Fast)
			end
		end)
		chip.MouseLeave:Connect(function()
			Tween(chip, { BackgroundColor3 = Theme.Raised }, Motion.Fast)
			if not keybind.Listening then
				Tween(chipStroke, { Color = Theme.Line }, Motion.Fast)
			end
		end)
		chip.Activated:Connect(function()
			if not keybind.Listening then
				keybind:_StartListening()
			end
		end)
		chip.MouseButton2Click:Connect(function()
			if keybind.Listening or os.clock() - keybind.CapturedAt < 0.25 then
				return
			end
			Library:_OpenPopover(modeMenu, chip)
		end)
		AttachTooltip(chip, "Click to bind. Hold Ctrl, Shift or Alt for a combo. Esc clears. Right-click for mode.")

		keybind:_RenderChip()
		keybind.LastEmitted = keybind:IsActive()
		if target == nil then
			keybind.LastEmitted = mode == "Always" and keybind:IsUsable()
		end
		table.insert(Library.Keybinds, keybind)
		if section then
			table.insert(section.Binds, keybind)
		end
		if mode == "Always" and target then
			task.defer(function()
				target:Set(true)
			end)
		end
		Library:_RefreshKeybindList()
		return keybind
	end

