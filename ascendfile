		local function makeButton(text, primary, order)
			local button = Create("TextButton", {
				Text = text,
				FontFace = Fonts.SemiBold,
				TextSize = 13,
				TextColor3 = primary and (danger and Color3.fromRGB(24, 8, 12) or Theme.OnAccent) or Theme.Text,
				AutoButtonColor = false,
				Size = UDim2.new(0, 0, 1, 0),
				AutomaticSize = Enum.AutomaticSize.X,
				BackgroundColor3 = primary and tone or Theme.Raised,
				LayoutOrder = order,
				Parent = footer,
			})
			Padding(button, 0, 16, 0, 16)
			Round(button, 4)
			local stroke = Stroke(button, primary and tone or Theme.LineStrong, primary and 0.4 or 0, 1)
			local rest = button.BackgroundColor3
			button.MouseEnter:Connect(function()
				Tween(button, { BackgroundColor3 = primary and Tinted(tone, 0.1) or Theme.Hover }, Motion.Fast)
				Tween(stroke, { Transparency = 0 }, Motion.Fast)
			end)
			button.MouseLeave:Connect(function()
				Tween(button, { BackgroundColor3 = rest }, Motion.Fast)
				Tween(stroke, { Transparency = primary and 0.4 or 0 }, Motion.Fast)
			end)
			PressScale(button)
			return button
		end
		local cancelButton = makeButton(tostring(options.CancelText or "Cancel"), false, 1)
		local confirmButton = makeButton(tostring(options.ConfirmText or "Confirm"), true, 2)

		local closed = false
		local armed = false
		local keyConnection = nil
		local function close(confirmed)
			if closed then
				return
			end
			closed = true
			if self.ActiveConfirm == close then
				self.ActiveConfirm = nil
			end
			if keyConnection then
				keyConnection:Disconnect()
				keyConnection = nil
			end
			Tween(overlay, { BackgroundTransparency = 1 }, Motion.Base)
			Tween(card, { GroupTransparency = 1 }, Motion.Base)
			Tween(cardStroke, { Transparency = 1 }, Motion.Base)
			Tween(cardScale, { Scale = confirmed and 1.04 or 0.94 }, Motion.Base, Enum.EasingStyle.Quad)
			task.delay(Motion.Base + 0.05, function()
				gui:Destroy()
			end)
			local handler = confirmed and options.OnConfirm or options.OnCancel
			local value = inputBox and inputBox.Text or nil
			task.spawn(function()
				if type(handler) == "function" then
					local ok, problem = pcall(handler, value)
					if not ok then
						warn("[Ascend] Confirm handler failed: " .. tostring(problem))
					end
				end
				if type(options.Callback) == "function" then
					local ok, problem = pcall(options.Callback, confirmed == true, value)
					if not ok then
						warn("[Ascend] Confirm callback failed: " .. tostring(problem))
					end
				end
			end)
		end
		self.ActiveConfirm = close

		local function nudge()
			local base = UDim2.fromScale(0.5, 0.5)
			for _, shift in ipairs({ 6, -5, 3, 0 }) do
				if closed then
					return
				end
				card.Position = base + UDim2.fromOffset(shift, 0)
				task.wait(0.04)
			end
		end

		cancelButton.Activated:Connect(function()
			close(false)
		end)
		confirmButton.Activated:Connect(function()
			if armed then
				close(true)
			end
		end)
		overlay.Activated:Connect(function()
			if danger then
				task.spawn(nudge)
			else
				close(false)
			end
		end)
		keyConnection = UserInputService.InputBegan:Connect(function(input)
			if closed or UserInputService:GetFocusedTextBox() then
				return
			end
			if input.KeyCode == Enum.KeyCode.Escape or input.KeyCode == Enum.KeyCode.ButtonB then
				close(false)
			elseif (input.KeyCode == Enum.KeyCode.Return or input.KeyCode == Enum.KeyCode.KeypadEnter) and armed then
				close(true)
			end
		end)

		confirmButton.BackgroundTransparency = 0.5
		Tween(overlay, { BackgroundTransparency = 0.45 }, Motion.Base)
		Tween(card, { GroupTransparency = 0 }, Motion.Base)
		Tween(cardStroke, { Transparency = 0 }, Motion.Base)
		Tween(cardScale, { Scale = 1 }, Motion.Slow, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		Tween(edgeGradient, { Offset = Vector2.new(1, 0) }, 0.9, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
		task.delay(0.35, function()
			if not closed then
				armed = true
				Tween(confirmButton, { BackgroundTransparency = 0 }, Motion.Fast)
			end
		end)
		if inputBox then
			inputBox.FocusLost:Connect(function(enterPressed)
				if enterPressed and armed and not closed then
					close(true)
				end
			end)
			task.delay(Motion.Base, function()
				if not closed then
					inputBox:CaptureFocus()
					inputBox.CursorPosition = #inputBox.Text + 1
				end
			end)
		end
		return { Close = close }
	end

	function Library:SetIncognito(enabled)
		self.Incognito = enabled == true
		if self.Window and self.Window.SetIncognito then
			self.Window:SetIncognito(self.Incognito)
		end
		for _, listener in ipairs(self.IncognitoListeners or {}) do
			SafeCall(listener, self.Incognito)
		end
	end

	function Library:OnIncognito(callback)
		self.IncognitoListeners = self.IncognitoListeners or {}
		table.insert(self.IncognitoListeners, callback)
	end

	function Library:SetNotificationsEnabled(enabled)
		self.NotificationsEnabled = enabled ~= false
		self:_PlaceNotifications()
	end

	function Library:GetNotifyPlacements()
		local labels = {}
		for _, key in ipairs(NotifyPlacementOrder) do
			table.insert(labels, NotifyPlacements[key].Label)
		end
		return labels
	end

	function Library:NotifyPlacementFromLabel(label)
		for key, placement in pairs(NotifyPlacements) do
			if placement.Label == label then
				return key
			end
		end
		return NotifyLegacyLabels[label]
	end

	function Library:NotifyPlacementLabel()
		local placement = NotifyPlacements[self.NotifyPosition] or NotifyPlacements.BottomRight
		return placement.Label
	end

