	function Tab:_SetActive(active, instant)
		self.Active = active
		local duration = instant and 0 or Motion.Base
		if active then
			Tween(self.Button, { BackgroundColor3 = Theme.Raised, BackgroundTransparency = 0 }, duration)
			Tween(self.Label, { TextColor3 = Theme.Text }, duration)
			if self.Icon then
				Tween(self.Icon, { ImageColor3 = Theme.Accent }, duration)
			end
		else
			Tween(self.Button, { BackgroundColor3 = Theme.Tile, BackgroundTransparency = 1 }, duration)
			Tween(self.Label, { TextColor3 = Theme.TextDim }, duration)
			if self.Icon then
				Tween(self.Icon, { ImageColor3 = Theme.TextFaint }, duration)
			end
		end
	end

	function Tab:Select()
		self.Window:SelectTab(self)
	end

	function Tab:_LayoutPins()
		self.PinnedSections = self.PinnedSections or {}
		for index, section in ipairs(self.PinnedSections) do
			local column = self.Right and (index % 2 == 0) and self.Right or self.Left
			if self.Columns == 1 then
				column = self.Left
			end
			section.Container.Parent = column
			section.Container.LayoutOrder = -1000 + index
		end
	end

	function Tab:SetSectionPinned(section, pinned, quiet)
		self.PinnedSections = self.PinnedSections or {}
		pinned = pinned == true
		if section.Pinned == pinned then
			return
		end
		section.Pinned = pinned
		local position = table.find(self.PinnedSections, section)
		if pinned and not position then
			table.insert(self.PinnedSections, section)
		elseif not pinned and position then
			table.remove(self.PinnedSections, position)
			section.Container.Parent = section.Home.Column
			section.Container.LayoutOrder = section.Home.Order
		end
		if section.TintPin then
			section.TintPin(pinned and Theme.Accent or Theme.TextFaint)
		end
		self:_LayoutPins()
		if not quiet then
			SafeCall(Library.OnPinsChanged, Library:GetPinnedSections())
		end
	end

	function Library:GetPinnedSections()
		local list = {}
		local window = self.Window
		for _, tab in ipairs(window and window.Tabs or {}) do
			for _, section in ipairs(tab.PinnedSections or {}) do
				table.insert(list, tab.Name .. "/" .. section.Name)
			end
		end
		return list
	end

	function Library:SetPinnedSections(list)
		local window = self.Window
		if not window or type(list) ~= "table" then
			return
		end
		for _, entry in ipairs(list) do
			local tabName, sectionName = string.match(tostring(entry), "^(.-)/(.+)$")
			for _, tab in ipairs(window.Tabs) do
				if tab.Name == tabName then
					for _, section in ipairs(tab.Sections) do
						if section.Name == sectionName and section.PinButton then
							tab:SetSectionPinned(section, true, true)
						end
					end
				end
			end
		end
	end

