			OnTheme(function()
				tintBadge(Theme.Accent, 0)
			end)
		end

		section:_RefreshLive(true)
		task.defer(function()
			section:_SetExpanded(section.Expanded, true)
		end)

		table.insert(self.Sections, section)
		return section
	end

	function Section:IsLive()
		if self.Owner and not self.Owner:IsLive() then
			return false
		end
		if self.Module then
			return self.Module.Value == true
		end
		return true
	end

	function Section:_BodyHeight()
		local factor = 1
		if self.DesignWidth and self.DesignWidth > 0 and self.Container.AbsoluteSize.X > 0 then
			factor = self.Container.AbsoluteSize.X / self.DesignWidth
		end
		if factor <= 0 then
			factor = 1
		end
		return math.floor(self.Frame.AbsoluteSize.Y / factor + 0.5)
	end

	function Section:_ApplyHeight(bodyHeight)
		self.Clip.Size = UDim2.new(1, 0, 0, bodyHeight)
		self.Container.Size = UDim2.new(1, 0, 0, self.HeaderHeight + (bodyHeight > 0 and bodyHeight + 1 or 0))
	end

	function Section:_SetExpanded(state, instant)
		if not self.Clip then
			return
		end
		self.Expanded = state
		self.ClipToken += 1
		local token = self.ClipToken
		local target = state and self:_BodyHeight() or 0
		if not state then
			Library:_ClosePopoversWithin(self.Container)
		end
		if self.SetChevron then
			self.SetChevron(not state, instant)
		end
		Tween(self.Divider, { BackgroundTransparency = state and 0 or 1 }, instant and 0 or Motion.Base)
		if self.HeaderFoot and (state or instant) then
			self.HeaderFoot.Visible = state
		end
		if instant then
			self.Animating = false
			self:_ApplyHeight(target)
			return
		end
		self.Animating = true
		local containerTarget = self.HeaderHeight + (target > 0 and target + 1 or 0)
		Tween(self.Clip, { Size = UDim2.new(1, 0, 0, target) }, Motion.Slow)
		Tween(self.Container, { Size = UDim2.new(1, 0, 0, containerTarget) }, Motion.Slow)
		task.delay(Motion.Slow + 0.02, function()
			if self.ClipToken ~= token then
				return
			end
			self.Animating = false
			if self.Expanded then
				self:_ApplyHeight(self:_BodyHeight())
			else
				self:_ApplyHeight(0)
				if self.HeaderFoot then
					self.HeaderFoot.Visible = false
				end
			end
		end)
	end

	function Section:SetExpanded(state)
		self:_SetExpanded(state == true, false)
	end

	function Section:_RefreshLive(instant)
		local live = self:IsLive()
		local blocker = self.Blocker
		if blocker then
			self.BlockerToken += 1
			local token = self.BlockerToken
			if live then
				Tween(blocker, { BackgroundTransparency = 1 }, instant and 0 or Motion.Base)
				task.delay(instant and 0 or Motion.Base, function()
					if self.BlockerToken == token then
						blocker.Visible = false
					end
				end)
			else
				blocker.Visible = true
				Tween(blocker, { BackgroundTransparency = 0.35 }, instant and 0 or Motion.Base)
				if self.Container then
					Library:_ClosePopoversWithin(self.Container)
				end
			end
		end
		for _, toggle in ipairs(self.Toggles) do
			toggle:_Emit()
		end
		for _, keybind in ipairs(self.Binds) do
			if not live then
				keybind.Armed = false
				if keybind.Mode == "Hold" and not keybind.Target then
					keybind.Active = false
				end
			end
			keybind:_Emit()
		end
		for _, child in ipairs(self.Children) do
			child:_RefreshLive(instant)
		end
		Library:_RefreshKeybindList()
	end

	function Section:_Next()
		self.Order += 1
		return self.Order
	end

	function Section:_Register(name, holder)
		table.insert(self.Elements, { Name = name, Holder = holder })
	end

	local function AttachLock(element, holder)
		local saved = {}
		local switched = {}
		element.Locked = false
		function element:SetLocked(state)
			state = state == true
			if self.Locked == state then
				return
			end
			self.Locked = state
			if state then
				Library:_ClosePopoversWithin(holder)
				table.clear(saved)
				table.clear(switched)
				local objects = holder:GetDescendants()
				table.insert(objects, holder)
				for _, object in ipairs(objects) do
					if object:IsA("GuiButton") or object:IsA("TextBox") then
						local ok, previous = pcall(function()
							return object.Interactable
						end)
						if ok then
							switched[object] = previous
							object.Interactable = false
						end
						if object:IsA("TextBox") then
							object:ReleaseFocus()
						end
					end
					if object ~= holder then
						local entry = {}
						if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
							entry.TextTransparency = object.TextTransparency
						end
						if object:IsA("ImageLabel") or object:IsA("ImageButton") then
							entry.ImageTransparency = object.ImageTransparency
						end
						if object:IsA("GuiObject") and object.BackgroundTransparency < 1 then
							entry.BackgroundTransparency = object.BackgroundTransparency
						end
						if object:IsA("UIStroke") then
							entry.Transparency = object.Transparency
						end
						if next(entry) then
							saved[object] = entry
							local target = {}
							for property, value in pairs(entry) do
								target[property] = value + (1 - value) * 0.55
							end
							Tween(object, target, Motion.Fast)
						end
					end
				end
			else
				for object, previous in pairs(switched) do
					pcall(function()
						object.Interactable = previous
					end)
				end
				table.clear(switched)
				for object, entry in pairs(saved) do
					if object.Parent then
						Tween(object, entry, Motion.Fast)
					end
				end
				table.clear(saved)
			end
		end
	end

