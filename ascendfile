				end
			end)
			holder.MouseLeave:Connect(function()
				Tween(holder, { BackgroundColor3 = Theme.Raised }, Motion.Fast)
				Tween(stroke, { Color = Theme.Line }, Motion.Fast)
				if icon then
					tintIcon(Theme.TextDim)
				end
			end)
			holder.Activated:Connect(function()
				SafeCall(info.Callback)
			end)
			AttachTooltip(holder, info.Tooltip)
			table.insert(buttons, holder)
			table.insert(names, tostring(info.Name or ""))
		end
		self:_Register(table.concat(names, " "), wrapper)
		return buttons
	end

	function Section:AddDropdown(options)
		options = options or {}
		local name = tostring(options.Name or "Dropdown")
		local multi = options.Multi == true
		local maxVisible = tonumber(options.MaxVisible) or 7
		local dropdown = {
			Type = "Dropdown",
			Name = name,
			Flag = options.Flag,
			Callback = options.Callback,
			Options = {},
			Multi = multi,
		}
		for _, option in ipairs(options.Options or {}) do
			local value = tostring(option)
			if not table.find(dropdown.Options, value) then
				table.insert(dropdown.Options, value)
			end
		end
		local searchable = options.Searchable
		if searchable == nil then
			searchable = #dropdown.Options > 8
		end
		if multi then
			dropdown.Value = {}
			if type(options.Default) == "table" then
				for _, value in ipairs(options.Default) do
					local text = tostring(value)
					if table.find(dropdown.Options, text) and not table.find(dropdown.Value, text) then
						table.insert(dropdown.Value, text)
					end
				end
			end
		else
			dropdown.Value = nil
			if options.Default ~= nil and table.find(dropdown.Options, tostring(options.Default)) then
				dropdown.Value = tostring(options.Default)
			end
		end

		local holder = BuildTile(self, 40)
		Padding(holder, 0, 7, 0, 10)
		Row(holder, 8)
		local title = BuildLabelBlock(holder, name, nil)
		local box = Create("TextButton", {
			Size = UDim2.new(0.5, 0, 0, 28),
			BackgroundColor3 = Theme.Raised,
			LayoutOrder = 2,
			Parent = holder,
		})
		Round(box, 7)
		local boxStroke = Stroke(box, Theme.Line)
		Create("UISizeConstraint", { MinSize = Vector2.new(104, 28), MaxSize = Vector2.new(176, 28), Parent = box })
		local selectedLabel = Text({
			Position = UDim2.fromOffset(10, 0),
			Size = UDim2.new(1, -32, 1, 0),
			TextSize = 12,
			TextTruncate = Enum.TextTruncate.AtEnd,
			Parent = box,
		})
		local chevron, setChevron, tintChevron = SwapGlyph(box, "chevron-down", "chevron-up", 14, Theme.TextFaint, Fallbacks.Chevron, {
			AnchorPoint = Vector2.new(1, 0.5),
			Position = UDim2.new(1, -8, 0.5, 0),
		})

		local popover = Library:_CreatePopover(180, nil)
		local searchBox = nil
		if searchable then
			local searchFrame = Create("Frame", {
				Size = UDim2.new(1, 0, 0, 30),
				BackgroundColor3 = Theme.Raised,
				LayoutOrder = 1,
				Parent = popover.Content,
			})
			Round(searchFrame, 7)
			Stroke(searchFrame, Theme.Line)
			Glyph(searchFrame, { "search" }, 13, Theme.TextFaint, Fallbacks.Search, {
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.new(0, 9, 0.5, 0),
			})
			searchBox = Create("TextBox", {
				Position = UDim2.fromOffset(29, 0),
				Size = UDim2.new(1, -37, 1, 0),
				BackgroundTransparency = 1,
				PlaceholderText = "Filter",
				PlaceholderColor3 = Theme.TextFaint,
				TextSize = 12,
				TextXAlignment = Enum.TextXAlignment.Left,
				ClearTextOnFocus = false,
				ClipsDescendants = true,
				Parent = searchFrame,
			})
		end
		local rowHeight = 30
		local scroll = Create("ScrollingFrame", {
			Size = UDim2.new(1, 0, 0, rowHeight),
			BackgroundTransparency = 1,
			ScrollBarThickness = 2,
			ScrollBarImageColor3 = Theme.LineStrong,
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollingDirection = Enum.ScrollingDirection.Y,
			LayoutOrder = 2,
			Parent = popover.Content,
		})
		List(scroll, 1)
		AutoScrollbar(scroll, 2)

		local optionRows = {}

		local function isSelected(option)
			if multi then
				return table.find(dropdown.Value, option) ~= nil
			end
			return dropdown.Value == option
		end

		local function updateDisplay()
			local empty
			local text
			if multi then
				empty = #dropdown.Value == 0
				if empty then
					text = tostring(options.Placeholder or "None")
				elseif #dropdown.Value == 1 then
					text = dropdown.Value[1]
				else
					text = tostring(#dropdown.Value) .. " selected"
				end
			else
				empty = dropdown.Value == nil
				text = empty and tostring(options.Placeholder or "None") or dropdown.Value
			end
			selectedLabel.Text = text
			selectedLabel.TextColor3 = empty and Theme.TextFaint or Theme.Text
			for _, row in pairs(optionRows) do
				row.Render()
			end
		end

		local function resizeList()
			local count = math.clamp(#dropdown.Options, 1, maxVisible)
			scroll.Size = UDim2.new(1, 0, 0, count * (rowHeight + 1))
		end

		local function commit()
			SetFlag(dropdown)
			updateDisplay()
			SafeCall(dropdown.Callback, CloneValue(dropdown.Value))
		end

		local function choose(option)
			if multi then
				local index = table.find(dropdown.Value, option)
				if index then
					table.remove(dropdown.Value, index)
				else
					table.insert(dropdown.Value, option)
				end
				commit()
			else
				dropdown.Value = option
				commit()
				Library:_ClosePopover(popover)
			end
		end

		local function createOption(option, index)
			local row = Create("TextButton", {
				Size = UDim2.new(1, 0, 0, rowHeight),
				BackgroundColor3 = Theme.Tile,
				BackgroundTransparency = 1,
				LayoutOrder = index,
				Parent = scroll,
			})
			Round(row, 6)
			Padding(row, 0, 8, 0, 10)
			Row(row, 8)
			PressScale(row)
			local label = Text({
				Text = option,
				Size = UDim2.new(0, 0, 1, 0),
				TextSize = 12,
				TextColor3 = Theme.TextDim,
				TextTruncate = Enum.TextTruncate.AtEnd,
				LayoutOrder = 1,
				Parent = row,
			})
			Fill(label)
			local box = nil
			local boxStroke = nil
			local check = nil
			if multi then
				box = Create("Frame", {
					Size = UDim2.fromOffset(16, 16),
					BackgroundColor3 = Theme.Raised,
					LayoutOrder = 2,
					Parent = row,
				})
				Round(box, 5)
				boxStroke = Stroke(box, Theme.LineStrong)
				check = Create("Frame", {
					AnchorPoint = Vector2.new(0.5, 0.5),
					Position = UDim2.fromScale(0.5, 0.5),
					Size = UDim2.fromOffset(6, 6),
					BackgroundColor3 = Theme.OnAccent,
					Visible = false,
					Parent = box,
				})
				Round(check, 1)
			else
				check = nil
			end
			local hovering = false
			local function render(instant)
				local selected = isSelected(option)
				local accentRow = selected and not multi
				local textColor = accentRow and Theme.Accent or ((selected or hovering) and Theme.Text or Theme.TextDim)
				local background = Theme.Tile
				local transparency = 1
				if accentRow then
					background = Theme.Accent
					transparency = hovering and 0.8 or 0.88
				elseif hovering then
					transparency = 0
				end
				if check then
					check.Visible = selected
					check.BackgroundColor3 = Theme.OnAccent
				end
				if instant then
					label.TextColor3 = textColor
					row.BackgroundColor3 = background
					row.BackgroundTransparency = transparency
					if box then
						box.BackgroundColor3 = selected and Theme.Accent or Theme.Raised
						boxStroke.Color = selected and Theme.Accent or Theme.LineStrong
					end
					return
				end
				Tween(label, { TextColor3 = textColor }, Motion.Fast)
				Tween(row, { BackgroundColor3 = background, BackgroundTransparency = transparency }, Motion.Fast)
				if box then
					Tween(box, { BackgroundColor3 = selected and Theme.Accent or Theme.Raised }, Motion.Fast)
					Tween(boxStroke, { Color = selected and Theme.Accent or Theme.LineStrong }, Motion.Fast)
				end
			end
			row.MouseEnter:Connect(function()
				hovering = true
				render()
			end)
			row.MouseLeave:Connect(function()
				hovering = false
				render()
			end)
			row.Activated:Connect(function()
				choose(option)
			end)
			optionRows[option] = { Row = row, Render = render }
			render(true)
		end

		for index, option in ipairs(dropdown.Options) do
			createOption(option, index)
		end
		resizeList()

		if searchBox then
			searchBox:GetPropertyChangedSignal("Text"):Connect(function()
				local query = string.lower(searchBox.Text)
				for option, row in pairs(optionRows) do
					row.Row.Visible = query == "" or string.find(string.lower(option), query, 1, true) ~= nil
				end
			end)
		end

		local listOpen = false
		local themeStale = false
		popover.OnBeforeOpen = function()
			local factor = (Library.Window and Library.Window.Scale) or 1
			popover.Width = math.max(math.floor(box.AbsoluteSize.X / factor + 0.5), 168)
			if themeStale then
				themeStale = false
				for _, row in pairs(optionRows) do
					row.Render(true)
				end
			end
			if searchBox then
				searchBox.Text = ""
			end
		end
		popover.OnOpen = function()
			listOpen = true
			Tween(boxStroke, { Color = Theme.Accent }, Motion.Fast)
			setChevron(true)
			tintChevron(Theme.Accent)
		end
		popover.OnClose = function()
			listOpen = false
			Tween(boxStroke, { Color = Theme.Line }, Motion.Fast)
			setChevron(false)
			tintChevron(Theme.TextFaint)
		end

		HoverTile(holder, function()
			Tween(title, { TextColor3 = Theme.Text }, Motion.Fast)
		end, function()
			Tween(title, { TextColor3 = Theme.TextDim }, Motion.Fast)
		end)
		PressScale(box)
		box.MouseEnter:Connect(function()
			Tween(box, { BackgroundColor3 = Theme.Hover }, Motion.Fast)
		end)
		box.MouseLeave:Connect(function()
			Tween(box, { BackgroundColor3 = Theme.Raised }, Motion.Fast)
		end)
		box.Activated:Connect(function()
			if dropdown.Locked then
				return
			end
			Library:_OpenPopover(popover, box)
		end)
		holder.Activated:Connect(function()
			if dropdown.Locked then
				return
			end
			Library:_OpenPopover(popover, box)
		end)

		function dropdown:Set(value, silent)
			if multi then
				self.Value = {}
				if type(value) == "table" then
					for _, item in ipairs(value) do
						local text = tostring(item)
						if table.find(self.Options, text) and not table.find(self.Value, text) then
							table.insert(self.Value, text)
						end
					end
				elseif value ~= nil then
					local text = tostring(value)
					if table.find(self.Options, text) then
						table.insert(self.Value, text)
					end
				end
			else
				if value == nil then
					self.Value = nil
				else
					local text = tostring(value)
					if table.find(self.Options, text) then
						self.Value = text
					end
				end
			end
			SetFlag(self)
			updateDisplay()
			if not silent then
				SafeCall(self.Callback, CloneValue(self.Value))
			end
			if self.Watchers then
				for _, watcher in ipairs(self.Watchers) do
					SafeCall(watcher, CloneValue(self.Value))
				end
			end
		end

		function dropdown:Get()
			return CloneValue(self.Value)
		end

		function dropdown:Refresh(newOptions, keepSelection)
			for _, row in pairs(optionRows) do
				row.Row:Destroy()
			end
			table.clear(optionRows)
			self.Options = {}
			for _, option in ipairs(newOptions or {}) do
				local text = tostring(option)
				if not table.find(self.Options, text) then
					table.insert(self.Options, text)
				end
			end
			if keepSelection then
				if multi then
					local kept = {}
					for _, item in ipairs(self.Value) do
						if table.find(self.Options, item) then
							table.insert(kept, item)
						end
					end
					self.Value = kept
				elseif self.Value ~= nil and not table.find(self.Options, self.Value) then
					self.Value = nil
				end
			else
				self.Value = multi and {} or nil
			end
			for index, option in ipairs(self.Options) do
				createOption(option, index)
			end
			resizeList()
			SetFlag(self)
			updateDisplay()
		end

		OnTheme(function()
			if not listOpen then
				themeStale = true
				return
			end
			for _, row in pairs(optionRows) do
				row.Render(true)
			end
		end)
		updateDisplay()
		RegisterElement(dropdown)
		AttachTooltip(title, options.Tooltip)
		AttachLock(dropdown, holder)
		self:_Register(name, holder)
		return dropdown
	end

