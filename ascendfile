		Row(inputs, 6)
		local preview = Create("Frame", {
			Size = UDim2.fromOffset(26, 26),
			BackgroundColor3 = default,
			LayoutOrder = 1,
			Parent = inputs,
		})
		preview:SetAttribute("AscendFixed", true)
		Round(preview, 6)
		Stroke(preview, Theme.LineStrong)
		local function inputBox(order, grow)
			local frame = Create("Frame", {
				Size = UDim2.new(0, 0, 0, 26),
				BackgroundColor3 = Theme.Raised,
				LayoutOrder = order,
				Parent = inputs,
			})
			Round(frame, 6)
			local stroke = Stroke(frame, Theme.Line)
			Create("UIFlexItem", { FlexMode = Enum.UIFlexMode.Custom, GrowRatio = grow, ShrinkRatio = 1, Parent = frame })
			local box = Create("TextBox", {
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				TextSize = 12,
				TextColor3 = Theme.TextDim,
