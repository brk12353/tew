		function panel:Destroy()
			if Library.Panels[id] == panel then
				Library.Panels[id] = nil
			end
			frame:Destroy()
		end

		self.Panels[id] = panel
		self:_ApplyOverlayScale()
		local saved = self.PendingPanelLayout and self.PendingPanelLayout[id]
		if type(saved) == "table" then
			local xs, xo, ys, yo = tonumber(saved[1]), tonumber(saved[2]), tonumber(saved[3]), tonumber(saved[4])
			if xs and xo and ys and yo then
				frame.Position = UDim2.new(xs, xo, ys, yo)
			end
		end
		return panel
	end

