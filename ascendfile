	function Library:_ApplyOverlayScale(value)
		if value then
			self.OverlayScale = value
		end
		local factor = self.OverlayScale or 1
		local frames = { self.KeybindList, self.Watermark, self.Tooltip, self.NotificationHolder }
		for _, panel in pairs(self.Panels or {}) do
			table.insert(frames, panel.Frame)
		end
		for _, frame in ipairs(frames) do
			if typeof(frame) == "Instance" and frame.Parent then
				local scale = frame:FindFirstChild("AscendOverlayScale")
				if not scale then
					scale = Create("UIScale", { Name = "AscendOverlayScale", Parent = frame })
				end
				if scale.Scale ~= factor then
					scale.Scale = factor
				end
			end
		end
	end

