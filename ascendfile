	function Library:_CloseUnrelatedPopovers(instance)
		local stack = self.PopoverStack
		for index = #stack, 1, -1 do
			local candidate = stack[index]
			if instance and instance:IsDescendantOf(candidate.Frame) then
				break
			end
			self:_ClosePopover(candidate)
		end
	end

	function Library:_PlacePopover(popover, anchor, align)
		local factor = (self.Window and self.Window.Scale) or 1
		popover.Scale.Scale = factor
		popover.Sync()
		local layer = self.PopoverLayer
		local origin = layer.AbsolutePosition
		local bounds = layer.AbsoluteSize
		local width = popover.Width * factor
		local height = popover.Frame.Size.Y.Offset * factor
		local anchorPosition = anchor.AbsolutePosition - origin
		local anchorSize = anchor.AbsoluteSize
		local x = anchorPosition.X + anchorSize.X - width
		if align == "left" then
			x = anchorPosition.X
		end
		local y = anchorPosition.Y + anchorSize.Y + 6
		if y + height > bounds.Y - 8 then
			y = anchorPosition.Y - height - 6
		end
		x = math.floor(math.clamp(x, 8, math.max(8, bounds.X - width - 8)) + 0.5)
		y = math.floor(math.clamp(y, 8, math.max(8, bounds.Y - height - 8)) + 0.5)
		return x, y
	end

	function Library:_OpenPopover(popover, anchor, align)
		if popover.Open then
			self:_ClosePopover(popover)
			return
		end
		local stack = self.PopoverStack
		self:_CloseUnrelatedPopovers(anchor)
		if popover.OnBeforeOpen then
			popover.OnBeforeOpen()
		end
		popover.Frame.Visible = true
		local x, y = self:_PlacePopover(popover, anchor, align)
		table.insert(stack, popover)
		local z = 210 + #stack * 4
		popover.Frame.ZIndex = z
		self.PopoverCatcher.ZIndex = z - 1
		self.PopoverCatcher.Visible = true
		popover.Open = true
		popover.Anchor = anchor
		popover.Align = align
		popover.Token += 1
		popover.Target = Vector2.new(x, y)
		popover.Frame.Position = UDim2.fromOffset(x, y - 6)
		popover.Frame.GroupTransparency = 1
		Tween(popover.Frame, { Position = UDim2.fromOffset(x, y), GroupTransparency = 0 }, Motion.Base)
		if popover.OnOpen then
			popover.OnOpen()
		end
	end


	function Library:_ReflowPopovers()
		self.ReflowToken = (self.ReflowToken or 0) + 1
		local token = self.ReflowToken
		task.defer(function()
			RunService.Heartbeat:Wait()
			if self.ReflowToken ~= token then
				return
			end
			for _, popover in ipairs(self.PopoverStack) do
				if popover.Open and popover.Anchor and popover.Anchor.Parent then
					local x, y = self:_PlacePopover(popover, popover.Anchor, popover.Align)
					popover.Target = Vector2.new(x, y)
					Tween(popover.Frame, { Position = UDim2.fromOffset(x, y) }, Motion.Fast)
				end
			end
		end)
	end

	function Library:_ClosePopover(popover)
		if not popover or not popover.Open then
			return
		end
		local stack = self.PopoverStack
		while #stack > 0 and stack[#stack] ~= popover do
			self:_ClosePopover(stack[#stack])
		end
		local index = table.find(stack, popover)
		if index then
			table.remove(stack, index)
		end
		popover.Open = false
		popover.Token += 1
		local token = popover.Token
		Tween(popover.Frame, {
			Position = UDim2.fromOffset(popover.Target.X, popover.Target.Y - 6),
			GroupTransparency = 1,
		}, Motion.Fast, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		task.delay(Motion.Fast + 0.03, function()
			if popover.Token == token then
				popover.Frame.Visible = false
			end
		end)
		if #stack > 0 then
			self.PopoverCatcher.ZIndex = stack[#stack].Frame.ZIndex - 1
		else
			self.PopoverCatcher.Visible = false
		end
		if popover.OnClose then
			popover.OnClose()
		end
	end

	function Library:_CloseAllPopovers()
		local stack = self.PopoverStack
		for index = #stack, 1, -1 do
			self:_ClosePopover(stack[index])
		end
	end

	function Library:_ClosePopoversWithin(container)
		local stack = self.PopoverStack
		for index = #stack, 1, -1 do
			local candidate = stack[index]
			if candidate and candidate.Anchor and candidate.Anchor:IsDescendantOf(container) then
				self:_ClosePopover(candidate)
			end
		end
	end

