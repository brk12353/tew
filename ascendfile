		for index, keybind in ipairs(self.Keybinds) do
			local entry = keybind.ListRow
			if not entry then
				local frame = Create("Frame", {
					Size = UDim2.new(1, 0, 0, 26),
					BackgroundColor3 = Theme.Accent,
					BackgroundTransparency = 1,
