	local function KeyName(key)
		if key == nil then
			return "None"
		end
		if IsGamepadKey(key) then
			return GamepadNames.DPad[key.Name] or GamepadNames[GamepadStyle()][key.Name] or (string.gsub(key.Name, "^Button", ""))
		end
		return KeyAliases[key.Name] or key.Name
	end

	local function ModifierOf(key)
		if typeof(key) == "EnumItem" and key.EnumType == Enum.KeyCode then
			return ModifierNames[key.Name]
		end
		return nil
	end

	local function HeldModifiers(exclude)
		local held = {}
		for _, name in ipairs(ModifierOrder) do
			if name ~= exclude then
				for _, keyCode in ipairs(ModifierKeys[name]) do
					if UserInputService:IsKeyDown(keyCode) then
						table.insert(held, name)
						break
					end
				end
			end
		end
		return held
	end

	local function NormalizeMods(mods)
		local set = {}
		if type(mods) == "table" then
			for _, mod in ipairs(mods) do
				local name = ModifierAliases[string.lower(tostring(mod))]
				if name then
					set[name] = true
				end
			end
		end
		local out = {}
		for _, name in ipairs(ModifierOrder) do
			if set[name] then
				table.insert(out, name)
			end
		end
		return out
	end

	local function ModsEqual(a, b)
		if #a ~= #b then
			return false
		end
		for index = 1, #a do
			if a[index] ~= b[index] then
				return false
			end
		end
		return true
	end

	local function ComboText(key, mods)
		if key == nil then
			return "None"
		end
		local parts = {}
		for _, mod in ipairs(mods or {}) do
			table.insert(parts, mod)
		end
		table.insert(parts, KeyName(key))
		return table.concat(parts, " + ")
	end

	local function LookupKey(name)
		if type(name) ~= "string" or name == "" then
			return nil
		end
		local attempts = { name, string.upper(name), string.upper(string.sub(name, 1, 1)) .. string.sub(name, 2) }
		for _, attempt in ipairs(attempts) do
			local ok, item = pcall(function()
				return Enum.KeyCode[attempt]
			end)
			if ok and item then
				return item
			end
			local okMouse, mouseItem = pcall(function()
				return Enum.UserInputType[attempt]
			end)
			if okMouse and mouseItem and string.find(attempt, "MouseButton", 1, true) then
				return mouseItem
			end
		end
		local lower = string.lower(name)
		for enumName, alias in pairs(KeyAliases) do
			if string.lower(alias) == lower then
				return LookupKey(enumName)
			end
		end
		local padName = GamepadLookup[lower]
		if padName then
			return Enum.KeyCode[padName]
		end
		local modifier = ModifierAliases[lower]
		if modifier then
			return ModifierKeys[modifier][1]
		end
		return nil
	end

	local function ParseBinding(value, modifiers)
		local extra = {}
		if type(modifiers) == "table" then
			for _, mod in ipairs(modifiers) do
				table.insert(extra, mod)
			end
		end
		if typeof(value) == "EnumItem" then
			return value, NormalizeMods(extra)
		end
		if type(value) ~= "string" or value == "" or value == "None" then
			return nil, {}
		end
		local tokens = {}
		for token in string.gmatch(value, "[^%+]+") do
			local trimmed = string.gsub(token, "^%s+", "")
			trimmed = string.gsub(trimmed, "%s+$", "")
			if trimmed ~= "" then
				table.insert(tokens, trimmed)
			end
		end
		if #tokens == 0 then
			return nil, {}
		end
		for index = 1, #tokens - 1 do
			table.insert(extra, tokens[index])
		end
		local key = LookupKey(tokens[#tokens])
		if key == nil then
			return nil, {}
		end
		local mods = NormalizeMods(extra)
		local own = ModifierOf(key)
		if own then
			local filtered = {}
			for _, mod in ipairs(mods) do
				if mod ~= own then
					table.insert(filtered, mod)
				end
			end
			mods = filtered
		end
		return key, mods
	end

	local function Matches(input, key)
		if key == nil then
			return false
		end
		if key.EnumType == Enum.KeyCode then
			return input.KeyCode == key
		end
		return input.UserInputType == key
	end

