	local function BuildToggle(row, options, section, onRender)
		local toggle = setmetatable({
			Type = "Toggle",
			Name = tostring(options.Name or "Toggle"),
			Flag = options.Flag,
			Callback = options.Callback,
			Value = options.Default == true,
			Accessories = row,
			Section = section,
		}, ToggleMethods)
		local track, renderSwitch = BuildSwitch(row, 40)
		toggle.Switch = track
		track.Activated:Connect(function()
			toggle:Set(not toggle.Value)
			local play = PressPlayers[row]
			if play then
				play()
			end
		end)
		track.MouseEnter:Connect(function()
			if not toggle.Value then
				Tween(track, { BackgroundColor3 = Theme.Hover }, Motion.Fast)
			end
		end)
		track.MouseLeave:Connect(function()
			toggle._Render(false)
		end)
		toggle._Render = function(instant)
			renderSwitch(toggle.Value, instant)
			if onRender then
				onRender(toggle.Value, instant)
			end
		end
		OnTheme(function()
			toggle._Render(true)
		end)
		toggle.LastEmitted = toggle:IsActive()
		if section then
			table.insert(section.Toggles, toggle)
		end
		table.insert(Library.AllToggles, toggle)
		RegisterElement(toggle)
		return toggle
	end

	function Library:CreateWindow(options)
		options = options or {}
		if options.Icons then
			self:SetIcons(options.Icons)
		end
		if typeof(options.Accent) == "Color3" then
			Theme.Accent = options.Accent
			Library.ThemeHexes = nil
		end
		if options.NotifyPosition then
			self.NotifyPosition = options.NotifyPosition
		end
		if options.Combos == false then
			self.AllowCombos = false
		end
		if type(options.ConfigFolder) == "string" and options.ConfigFolder ~= "" then
			self.ConfigFolder = string.gsub(options.ConfigFolder, "[^%w _%-]", "")
		end
		local gui = self:_EnsureGui()
		self:_PlaceNotifications()

		local window = setmetatable({}, Window)
		window.Title = tostring(options.Title or "Ascend")
		window.Subtitle = tostring(options.Subtitle or "")
		window.ToggleKey = options.ToggleKey or Enum.KeyCode.RightAlt
		if options.GamepadToggleKey == false then
			window.GamepadToggleKey = nil
		else
			window.GamepadToggleKey = IsGamepadKey(options.GamepadToggleKey) and options.GamepadToggleKey or Enum.KeyCode.ButtonR3
		end
		window.GamepadCursor = options.GamepadCursor ~= false
		window.Tabs = {}
		window.TabOrder = 0
		window.Visible = false
		window.Minimized = false
		window.Dragged = false
		window.Destroyed = false
		window.AnimToken = 0
		window.BubbleToken = 0
		window.Scale = 1
		local size = options.Size
		if typeof(size) == "UDim2" then
			size = Vector2.new(size.X.Offset, size.Y.Offset)
		end
		if typeof(size) ~= "Vector2" then
			size = Vector2.new(740, 500)
		end
		local startCamera = workspace.CurrentCamera
		if startCamera and startCamera.ViewportSize.X > 0 and startCamera.ViewportSize.Y > 0 then
			local viewport = startCamera.ViewportSize
			size = Vector2.new(math.min(size.X, math.max(560, viewport.X - 24)), math.min(size.Y, math.max(340, viewport.Y - 56)))
		end
		size = Vector2.new(math.floor(math.max(size.X, 560)), math.floor(math.max(size.Y, 340)))
		window.UserScale = 1
		window.Opacity = 1
		window.Size = UDim2.fromOffset(size.X, size.Y)
		window.Width = size.X
		window.Height = size.Y
		self.WatermarkTitle = window.Title
		self.Window = window

		local railWidth = size.X < 680 and 160 or 184
		local headerHeight = 54
		local pagePadding = 16
		local columnGap = 12
		window.RailWidth = railWidth
		window.HeaderHeight = headerHeight
		window.ContentWidth = size.X - railWidth - pagePadding * 2 - 4
		window.ColumnWidth = math.floor((window.ContentWidth - columnGap) / 2)
		window.ColumnGap = columnGap
		window.PagePadding = pagePadding
		window.SingleColumn = window.ColumnWidth < 210

		local shell = Create("Frame", {
			Name = "Window",
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0.5, -math.floor(size.Y / 2)),
			Size = window.Size,
			BackgroundTransparency = 1,
			Visible = false,
			ZIndex = 10,
			Parent = gui,
		})
