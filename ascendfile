	local function AutoScrollbar(scroll, thickness)
		if not scroll:GetAttribute("AscendAutoHide") then
			scroll.ScrollBarImageTransparency = 0.5
		end
		scroll.TopImage = "rbxasset://textures/ui/Scroll/scroll-middle.png"
		scroll.BottomImage = "rbxasset://textures/ui/Scroll/scroll-middle.png"
		local function update()
			local overflow = scroll.AbsoluteCanvasSize.Y - scroll.AbsoluteWindowSize.Y
			scroll.ScrollBarThickness = overflow > 2 and thickness or 0
		end
		scroll:GetPropertyChangedSignal("AbsoluteCanvasSize"):Connect(update)
		scroll:GetPropertyChangedSignal("AbsoluteWindowSize"):Connect(update)
		update()
