	local function SharedEnvironment()
		local environment = nil
		pcall(function()
			if typeof(getgenv) == "function" then
				environment = getgenv()
			end
		end)
		if type(environment) ~= "table" then
			environment = shared
		end
		return environment
	end

	local environment = SharedEnvironment()
	local previous = environment.AscendLibrary
	if type(previous) == "table" and previous ~= Library and type(previous.Destroy) == "function" then
		pcall(function()
			previous:Destroy()
		end)
	end
	environment.AscendLibrary = Library

	Library.Controls = {}
	local function TrackControl(kind, section, name, element, fire)
		table.insert(Library.Controls, {
			Kind = kind,
			Name = tostring(name or ""),
			Section = section,
			Element = element,
			Fire = fire,
		})
	end
	for _, kind in ipairs({ "Toggle", "Slider", "Dropdown", "Button" }) do
		local original = Section["Add" .. kind]
		Section["Add" .. kind] = function(self, options, ...)
			local element = original(self, options, ...)
			if type(element) == "table" then
				local fire = nil
				if kind == "Button" then
					fire = function()
						element:Fire()
					end
				end
				TrackControl(kind, self, element.Name, element, fire)
			end
			return element
		end
	end
	local originalButtons = Section.AddButtons
	Section.AddButtons = function(self, list, ...)
		local result = originalButtons(self, list, ...)
		for _, info in ipairs(list or {}) do
			if type(info) == "table" then
				TrackControl("Button", self, info.Name, nil, function()
					SafeCall(info.Callback)
				end)
			end
		end
		return result
	end

	function Library:OpenCommandBar(options)
		options = options or {}
		if self.CommandBar then
			self.CommandBar.Close()
		end
		local mainGui = self:_EnsureGui()
		local gui = Create("ScreenGui", {
			Name = "Ascend_CommandBar",
			ResetOnSpawn = false,
			IgnoreGuiInset = true,
			ScreenInsets = Enum.ScreenInsets.None,
			ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
			DisplayOrder = mainGui.DisplayOrder + 1,
			Parent = mainGui.Parent,
		})
		local overlay = Create("TextButton", {
			Name = "CommandBarOverlay",
			Text = "",
			AutoButtonColor = false,
			Size = UDim2.fromScale(1, 1),
			BackgroundColor3 = Color3.new(0, 0, 0),
			BackgroundTransparency = 1,
			ZIndex = 880,
			Parent = gui,
		})
		local card = Create("CanvasGroup", {
			AnchorPoint = Vector2.new(0.5, 0),
			Position = UDim2.new(0.5, 0, 0.22, 0),
			Size = UDim2.fromOffset(460, 0),
			AutomaticSize = Enum.AutomaticSize.Y,
			BackgroundColor3 = Theme.Popover,
			GroupTransparency = 1,
			Active = true,
			ZIndex = 881,
			Parent = overlay,
		})
		Round(card, 4)
		local cardStroke = Stroke(card, Theme.LineStrong, 1, 1)
		local scale = Create("UIScale", { Scale = (self.OverlayScale or 1) * 0.96, Parent = card })
		List(card, 0)
		local inputRow = Create("Frame", {
			Size = UDim2.new(1, 0, 0, 44),
			BackgroundTransparency = 1,
			LayoutOrder = 1,
			Parent = card,
		})
		Padding(inputRow, 0, 14, 0, 14)
		Row(inputRow, 10)
		Glyph(inputRow, { "terminal", "search" }, 16, Theme.Accent, Fallbacks.Dot, { LayoutOrder = 1 })
		local box = Create("TextBox", {
			Text = "",
			PlaceholderText = tostring(options.Placeholder or "Type a command"),
			PlaceholderColor3 = Theme.TextFaint,
			ClearTextOnFocus = false,
			TextSize = 14,
			FontFace = Fonts.Medium,
			TextColor3 = Theme.Text,
			TextXAlignment = Enum.TextXAlignment.Left,
			BackgroundTransparency = 1,
			Size = UDim2.new(0, 0, 1, 0),
			ClipsDescendants = true,
			LayoutOrder = 2,
			Parent = inputRow,
		})
		Fill(box)
		local divider = Create("Frame", {
			Size = UDim2.new(1, 0, 0, 1),
			BackgroundColor3 = Theme.Line,
			LayoutOrder = 2,
			Parent = card,
		})
		local rowHeight = 30
		local maxRows = 9
		local listFrame = Create("ScrollingFrame", {
			Size = UDim2.new(1, 0, 0, 0),
			BackgroundTransparency = 1,
			ScrollBarThickness = 3,
			ScrollBarImageColor3 = Theme.LineStrong,
			CanvasSize = UDim2.new(),
			AutomaticCanvasSize = Enum.AutomaticSize.Y,
			ScrollingDirection = Enum.ScrollingDirection.Y,
			LayoutOrder = 3,
			Parent = card,
		})
		Padding(listFrame, 6, 8, 6, 6)
		List(listFrame, 2)
		task.defer(AutoHideScrollbar, listFrame)

		local rows = {}
		local suggestions = {}
		local selected = 1
		local closed = false
		local connections = {}
		local bar = {}

		local function paintSelection(follow)
			for index, row in ipairs(rows) do
				local active = index == selected
				row.Frame.BackgroundTransparency = active and 0 or 1
				row.Name.TextColor3 = active and Theme.Text or Theme.TextDim
			end
			if follow and rows[selected] then
				local row = rows[selected].Frame
				local factor = math.max(listFrame.AbsoluteSize.Y / math.max(listFrame.Size.Y.Offset, 1), 0.01)
				local relative = row.AbsolutePosition.Y - listFrame.AbsolutePosition.Y
				local height = row.AbsoluteSize.Y
				local view = listFrame.AbsoluteWindowSize.Y
				local current = listFrame.CanvasPosition.Y
				if relative < 6 * factor then
					listFrame.CanvasPosition = Vector2.new(0, math.max(current + (relative - 6 * factor) / factor, 0))
				elseif relative + height > view - 6 * factor then
					listFrame.CanvasPosition = Vector2.new(0, current + (relative + height - view + 6 * factor) / factor)
				end
			end
		end

		local function refresh()
			for _, row in ipairs(rows) do
				row.Frame:Destroy()
			end
			table.clear(rows)
			local ok, result = pcall(options.Suggest or function()
				return {}
			end, box.Text)
			suggestions = ok and type(result) == "table" and result or {}
			local shownRows = math.min(#suggestions, maxRows)
			listFrame.Size = UDim2.new(1, 0, 0, shownRows > 0 and (shownRows * (rowHeight + 2) + 10) or 0)
			listFrame.CanvasPosition = Vector2.zero
			for index = 1, math.min(#suggestions, 400) do
				local item = suggestions[index]
				local rowFrame = Create("TextButton", {
					Text = "",
					AutoButtonColor = false,
					Size = UDim2.new(1, 0, 0, rowHeight),
					BackgroundColor3 = Theme.Raised,
					BackgroundTransparency = 1,
					LayoutOrder = index,
					Parent = listFrame,
				})
				Round(rowFrame, 4)
				Padding(rowFrame, 0, 10, 0, 10)
				Row(rowFrame, 8)
				local nameLabel = Text({
					Text = tostring(item.Label or ""),
					TextSize = 13,
					FontFace = Fonts.Medium,
					TextColor3 = Theme.TextDim,
					Size = UDim2.new(0, 0, 1, 0),
					TextTruncate = Enum.TextTruncate.AtEnd,
					LayoutOrder = 1,
					Parent = rowFrame,
				})
				Fill(nameLabel)
				Text({
					Text = tostring(item.Hint or ""),
					TextSize = 11,
					FontFace = Fonts.Regular,
					TextColor3 = Theme.TextFaint,
					Size = UDim2.new(0, 0, 1, 0),
					AutomaticSize = Enum.AutomaticSize.X,
					LayoutOrder = 2,
					Parent = rowFrame,
				})
				rowFrame.MouseEnter:Connect(function()
					selected = index
					paintSelection()
				end)
				rowFrame.Activated:Connect(function()
					if item.Fill then
						box.Text = item.Fill
						box.CursorPosition = #box.Text + 1
						box:CaptureFocus()
					end
				end)
				table.insert(rows, { Frame = rowFrame, Name = nameLabel })
			end
			selected = math.clamp(selected, 1, math.max(#rows, 1))
			divider.Visible = #rows > 0
			paintSelection()
		end

		local function close()
			if closed then
				return
			end
			closed = true
			if self.CommandBar == bar then
				self.CommandBar = nil
			end
			for _, connection in ipairs(connections) do
				connection:Disconnect()
			end
			Tween(card, { GroupTransparency = 1 }, Motion.Fast)
			Tween(cardStroke, { Transparency = 1 }, Motion.Fast)
			Tween(overlay, { BackgroundTransparency = 1 }, Motion.Fast)
			task.delay(Motion.Fast + 0.05, function()
				gui:Destroy()
			end)
		end
		bar.Close = close
		self.CommandBar = bar

		local function submit()
			local text = box.Text
			if text:match("^%s*$") then
				local item = suggestions[selected]
				if item and item.Fill then
					box.Text = item.Fill
					box:CaptureFocus()
				end
				return
			end
			close()
			SafeCall(options.OnSubmit, text)
		end

		table.insert(connections, box:GetPropertyChangedSignal("Text"):Connect(function()
			selected = 1
			refresh()
		end))
		table.insert(connections, box.FocusLost:Connect(function(enterPressed)
			if closed then
				return
			end
			if enterPressed then
				submit()
			end
		end))
		table.insert(connections, UserInputService.InputBegan:Connect(function(input)
			if closed then
				return
			end
			local key = input.KeyCode
			if key == Enum.KeyCode.Escape then
				close()
			elseif key == Enum.KeyCode.Down then
				selected = math.min(selected + 1, math.max(#rows, 1))
				paintSelection(true)
			elseif key == Enum.KeyCode.Up then
				selected = math.max(selected - 1, 1)
				paintSelection(true)
			elseif key == Enum.KeyCode.Tab then
				local item = suggestions[selected]
				if item and item.Fill then
					task.defer(function()
						box.Text = item.Fill
						box.CursorPosition = #box.Text + 1
						box:CaptureFocus()
					end)
				end
			end
		end))
		overlay.Activated:Connect(close)

		refresh()
		Tween(overlay, { BackgroundTransparency = 0.6 }, Motion.Base)
		Tween(card, { GroupTransparency = 0 }, Motion.Base)
		Tween(cardStroke, { Transparency = 0 }, Motion.Base)
		Tween(scale, { Scale = self.OverlayScale or 1 }, Motion.Base, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		task.defer(function()
			if not closed then
				box:CaptureFocus()
			end
		end)
		return bar
	end

	return Library
end)()

Ascend.cloneref = cloneref
Ascend.Services = Services
Ascend.IconPack = IconPack

return Ascend
