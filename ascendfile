			end
			local shown = keybind.Value ~= nil and keybind.ShowInList
			entry.Frame.Visible = shown
			if shown then
				shownCount += 1
				local active = keybind:IsActive()
				if active then
					activeCount += 1
				end
				local isMouse = keybind.Value.EnumType ~= Enum.KeyCode
				local isPad = IsGamepadKey(keybind.Value)
				if entry.Keyboard then
					entry.Keyboard.Visible = not isMouse and not isPad
				end
				if entry.Mouse then
					entry.Mouse.Visible = isMouse
				end
				if entry.Pad then
					entry.Pad.Visible = isPad
