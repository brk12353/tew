	local function Tween(instance, properties, duration, style, direction)
		if typeof(instance) ~= "Instance" then
			return nil
		end
		local info = TweenInfo.new(duration or Motion.Base, style or Enum.EasingStyle.Quint, direction or Enum.EasingDirection.Out)
		local ok, tween = pcall(TweenService.Create, TweenService, instance, info, properties)
		if ok and tween then
			tween:Play()
			return tween
		end
		return nil
	end

	local function AutoHideScrollbar(scroll)
		if not scroll:IsA("ScrollingFrame") or scroll:GetAttribute("AscendAutoHide") then
			return
		end
		scroll:SetAttribute("AscendAutoHide", true)
		local shown = scroll.ScrollBarImageTransparency
		if shown <= 0.05 or shown >= 0.95 then
			shown = 0.45
		end
		local hovering = false
		local token = 0
		local visible = false
		scroll.ScrollBarImageTransparency = 1
		local function hideLater()
			token += 1
			local mine = token
			task.delay(1, function()
				if mine == token and not hovering and scroll.Parent then
					visible = false
					Tween(scroll, { ScrollBarImageTransparency = 1 }, Motion.Slow)
				end
			end)
		end
		local function show()
			if not visible then
				visible = true
				Tween(scroll, { ScrollBarImageTransparency = shown }, Motion.Fast)
			end
			hideLater()
		end
		scroll.MouseEnter:Connect(function()
			hovering = true
			show()
		end)
		scroll.MouseLeave:Connect(function()
			hovering = false
			hideLater()
		end)
		scroll:GetPropertyChangedSignal("CanvasPosition"):Connect(show)
	end
	Library.AutoHideScrollbar = AutoHideScrollbar

	local function SafeCall(callback, ...)
		if type(callback) ~= "function" then
			return
		end
		local args = table.pack(...)
		task.spawn(function()
			local ok, err = pcall(callback, table.unpack(args, 1, args.n))
			if not ok then
				warn("[Ascend] " .. tostring(err))
			end
		end)
	end

	local function Connect(signal, callback)
		local connection = signal:Connect(callback)
		table.insert(Library.Connections, connection)
		return connection
	end

	local function OnTheme(callback)
		table.insert(Library.ThemeHooks, callback)
		callback()
	end

	local function IsPrimary(input)
		return input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch
	end

	local function IsMove(input)
		return input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch
	end

	local function MousePosition()
		local mouse = UserInputService:GetMouseLocation()
		local inset = GuiService:GetGuiInset()
		return Vector2.new(mouse.X - inset.X, mouse.Y - inset.Y)
	end

	local function ToVector2(value)
		if typeof(value) == "Vector2" then
			return value
		end
		if type(value) == "table" then
			local x = tonumber(value[1] or value.X or value.x)
			local y = tonumber(value[2] or value.Y or value.y)
			if x and y then
				return Vector2.new(x, y)
			end
		end
		return nil
	end

	local function AssetString(value)
		if type(value) == "number" then
			return "rbxassetid://" .. tostring(value)
		end
		if type(value) == "string" then
			if string.match(value, "^%d+$") then
				return "rbxassetid://" .. value
			end
			if string.find(value, "rbxasset", 1, true) or string.find(value, "http", 1, true) then
				return value
			end
		end
		return nil
	end

	local function NormalizeIcon(data)
		local image = AssetString(data.Image or data.Id or data.Asset or data.Icon or data.Url or data[1])
		if not image then
			return nil
		end
		return {
			Image = image,
			RectSize = ToVector2(data.ImageRectSize or data.RectSize or data.Size or data[2]),
			RectOffset = ToVector2(data.ImageRectOffset or data.RectOffset or data.Position or data.Offset or data[3]),
		}
	end

	local function ResolveIcon(icon)
		if icon == nil then
			return nil
		end
		if type(icon) == "table" then
			return NormalizeIcon(icon)
		end
		local direct = AssetString(icon)
		if direct then
			return { Image = direct }
		end
		if type(icon) ~= "string" or type(Library.Icons) ~= "table" then
			return nil
		end
		local lower = string.lower(icon)
		local stripped = string.gsub(lower, "^lucide%-", "")
		local underscored = string.gsub(stripped, "%-", "_")
		local candidates = { icon, lower, "lucide-" .. stripped, stripped, underscored }
		for _, key in ipairs(candidates) do
			local value = Library.Icons[key]
			if value ~= nil then
				if type(value) == "table" then
					return NormalizeIcon(value)
				end
				local asset = AssetString(value)
				if asset then
					return { Image = asset }
				end
			end
		end
		return nil
	end

	local function ResolveFirst(names)
		if type(names) ~= "table" then
			return ResolveIcon(names)
		end
		for index = 1, 8 do
			local name = names[index]
			if name ~= nil then
				local resolved = ResolveIcon(name)
				if resolved then
					return resolved
				end
			end
		end
		return nil
	end

	local function ApplyIcon(image, resolved)
		image.Image = resolved.Image
		image.ImageRectSize = resolved.RectSize or Vector2.zero
		image.ImageRectOffset = resolved.RectOffset or Vector2.zero
	end

	local function IconImage(resolved, properties)
		local image = Create("ImageLabel", {
			BackgroundTransparency = 1,
			ScaleType = Enum.ScaleType.Fit,
		})
		ApplyIcon(image, resolved)
		for key, value in pairs(properties) do
			if key ~= "Parent" then
				image[key] = value
			end
		end
		image.Parent = properties.Parent
		return image
	end

	local function Bar(parent, width, rotation, color, offset)
		local bar = Create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, offset and offset.X or 0, 0.5, offset and offset.Y or 0),
			Size = UDim2.fromOffset(width, 2),
			Rotation = rotation or 0,
			BackgroundColor3 = color,
			Parent = parent,
		})
		Round(bar, 1)
		return bar
	end

	local Fallbacks = {}

	function Fallbacks.Cross(frame, color, size)
		local length = math.floor(size * 0.85)
		return {
			{ Bar(frame, length, 45, color), "BackgroundColor3" },
			{ Bar(frame, length, -45, color), "BackgroundColor3" },
		}
	end

	function Fallbacks.Minus(frame, color, size)
		return { { Bar(frame, math.floor(size * 0.75), 0, color), "BackgroundColor3" } }
	end

	function Fallbacks.Chevron(frame, color, size)
		local length = math.max(5, math.floor(size * 0.5))
		local shift = math.floor(length * 0.35)
		return {
			{ Bar(frame, length, 45, color, Vector2.new(-shift, 1)), "BackgroundColor3" },
			{ Bar(frame, length, -45, color, Vector2.new(shift, 1)), "BackgroundColor3" },
		}
	end

	function Fallbacks.Dots(frame, color)
		local parts = {}
		for index = -1, 1 do
			local dot = Create("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.new(0.5, index * 5, 0.5, 0),
				Size = UDim2.fromOffset(3, 3),
				BackgroundColor3 = color,
				Parent = frame,
			})
			Pill(dot)
			table.insert(parts, { dot, "BackgroundColor3" })
		end
		return parts
	end

	function Fallbacks.Dot(frame, color, size)
		local dot = Create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(math.max(4, math.floor(size * 0.4)), math.max(4, math.floor(size * 0.4))),
			BackgroundColor3 = color,
			Parent = frame,
		})
		Pill(dot)
		return { { dot, "BackgroundColor3" } }
	end

	function Fallbacks.Ring(frame, color, size)
		local ring = Create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(size - 3, size - 3),
			BackgroundTransparency = 1,
			Parent = frame,
		})
		Pill(ring)
		local ringStroke = Stroke(ring, color, 0, 1.5)
		local core = Create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(4, 4),
			BackgroundColor3 = color,
			Parent = ring,
		})
		Pill(core)
		return { { ringStroke, "Color" }, { core, "BackgroundColor3" } }
	end

	function Fallbacks.Search(frame, color)
		local ring = Create("Frame", {
			Position = UDim2.fromOffset(1, 1),
			Size = UDim2.fromOffset(9, 9),
			BackgroundTransparency = 1,
			Parent = frame,
		})
		Pill(ring)
		local ringStroke = Stroke(ring, color, 0, 1.5)
		local handle = Create("Frame", {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromOffset(11, 11),
			Size = UDim2.fromOffset(4, 2),
			Rotation = 45,
			BackgroundColor3 = color,
			Parent = frame,
		})
		Round(handle, 1)
		return { { ringStroke, "Color" }, { handle, "BackgroundColor3" } }
	end

	local function Glyph(parent, names, size, color, fallback, properties)
		local resolved = ResolveFirst(names)
		local object
		local parts
		if resolved then
			object = IconImage(resolved, { Size = UDim2.fromOffset(size, size), ImageColor3 = color, Parent = parent })
			parts = { { object, "ImageColor3" } }
		elseif fallback then
			object = Create("Frame", { Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1, Parent = parent })
			parts = fallback(object, color, size)
		else
			return nil, function() end
		end
		if properties then
			for key, value in pairs(properties) do
				object[key] = value
			end
		end
		local function tint(newColor, duration)
			for _, part in ipairs(parts) do
				if duration == 0 then
					part[1][part[2]] = newColor
				else
					Tween(part[1], { [part[2]] = newColor }, duration or Motion.Fast)
				end
			end
		end
		return object, tint
	end

	local function SwapGlyph(parent, firstIcon, secondIcon, size, color, fallback, properties)
		local first = ResolveIcon(firstIcon)
		local second = ResolveIcon(secondIcon)
		if not first or not second then
			local object, tint = Glyph(parent, { firstIcon }, size, color, fallback, properties)
			local function setState(state, instant)
				if object then
					Tween(object, { Rotation = state and 180 or 0 }, instant and 0 or Motion.Base)
				end
			end
			return object, setState, tint
		end
		local holder = Create("Frame", {
			Size = UDim2.fromOffset(size, size),
			BackgroundTransparency = 1,
		})
		if properties then
			for key, value in pairs(properties) do
				holder[key] = value
			end
		end
		local firstImage = IconImage(first, {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.fromScale(0.5, 0.5),
			Size = UDim2.fromOffset(size, size),
			ImageColor3 = color,
			Parent = holder,
		})
		local secondImage = IconImage(second, {
			AnchorPoint = Vector2.new(0.5, 0.5),
			Position = UDim2.new(0.5, 3, 0.5, 0),
			Size = UDim2.fromOffset(size, size),
			ImageColor3 = color,
			ImageTransparency = 1,
			Parent = holder,
		})
		holder.Parent = parent
		local function setState(state, instant)
			local duration = instant and 0 or 0.4
			Tween(firstImage, {
				ImageTransparency = state and 1 or 0,
				Position = state and UDim2.new(0.5, -3, 0.5, 0) or UDim2.fromScale(0.5, 0.5),
			}, duration)
			Tween(secondImage, {
				ImageTransparency = state and 0 or 1,
				Position = state and UDim2.fromScale(0.5, 0.5) or UDim2.new(0.5, 3, 0.5, 0),
			}, duration)
		end
		local function tint(newColor, duration)
			Tween(firstImage, { ImageColor3 = newColor }, duration or Motion.Fast)
			Tween(secondImage, { ImageColor3 = newColor }, duration or Motion.Fast)
		end
		return holder, setState, tint
	end

	local DragState = { Owner = nil, Candidates = {} }

	local function DragRank(object)
		local rank = 0
		local current = object
		while current and current.Parent do
			if current.Parent:IsA("LayerCollector") then
				if current:IsA("GuiObject") then
					rank = current.ZIndex
				end
				break
			end
			current = current.Parent
		end
		return rank
	end

	local GrabLocks = {}

	local function EndGrab(owner)
		if DragState.Owner ~= owner then
			return
		end
		DragState.Owner = nil
		DragState.Release = nil
		for _, frame in ipairs(GrabLocks) do
			frame.ScrollingEnabled = true
		end
		table.clear(GrabLocks)
	end

	local function BeginGrab(owner, gui, release)
		if DragState.Owner ~= nil and DragState.Owner ~= owner then
			return false
		end
		DragState.Owner = owner
		DragState.Release = release
		table.clear(DragState.Candidates)
		local current = gui
		while current and not current:IsA("LayerCollector") do
			if current:IsA("ScrollingFrame") and current.ScrollingEnabled then
				current.ScrollingEnabled = false
				table.insert(GrabLocks, current)
			end
			current = current.Parent
		end
		return true
	end

	Connect(UserInputService.WindowFocusReleased, function()
		local release = DragState.Release
		if type(release) == "function" then
			release()
		end
	end)

	local function TrackGradient(gradient)
		table.insert(Library.Gradients, gradient)
		return gradient
	end

	local function MakeDraggable(handle, target, onStart)
		local dragger = { Dragging = false, Start = nil, Origin = nil }
		function dragger.Begin(input)
			if DragState.Owner ~= nil and DragState.Owner ~= dragger then
				return
			end
			DragState.Owner = dragger
			dragger.Dragging = true
			dragger.Start = input.Position
			dragger.Origin = target.Position
			if onStart then
				onStart()
			end
		end
		handle.InputBegan:Connect(function(input)
			if not IsPrimary(input) or DragState.Owner then
				return
			end
			table.insert(DragState.Candidates, { Dragger = dragger, Rank = DragRank(target), Input = input })
			if #DragState.Candidates > 1 then
				return
			end
			task.defer(function()
				local best = nil
				for _, candidate in ipairs(DragState.Candidates) do
					if not best or candidate.Rank > best.Rank then
						best = candidate
					end
				end
				table.clear(DragState.Candidates)
				if best and not DragState.Owner then
					best.Dragger.Begin(best.Input)
				end
			end)
		end)
		Connect(UserInputService.InputChanged, function(input)
			if dragger.Dragging and DragState.Owner == dragger and IsMove(input) and dragger.Start and dragger.Origin then
				local delta = input.Position - dragger.Start
				local origin = dragger.Origin
				Tween(target, {
					Position = UDim2.new(origin.X.Scale, origin.X.Offset + delta.X, origin.Y.Scale, origin.Y.Offset + delta.Y),
				}, 0.1, Enum.EasingStyle.Quad)
			end
		end)
		local function finish()
			dragger.Dragging = false
			if DragState.Owner == dragger then
				DragState.Owner = nil
			end
		end
		Connect(UserInputService.InputEnded, function(input)
			if dragger.Dragging and IsPrimary(input) then
				finish()
			end
		end)
		Connect(UserInputService.WindowFocusReleased, function()
			if dragger.Dragging then
				finish()
			end
		end)
	end

	local function ShineTargets(root)
		local list = {}
		local function consider(object)
			local isText = object:IsA("TextLabel") or object:IsA("TextButton")
			local isImage = object:IsA("ImageLabel") or object:IsA("ImageButton")
			if not (isText or isImage) or not object.Visible then
				return
			end
			if isText and object.Text == "" then
				return
			end
			if isImage and object.Image == "" then
				return
			end
			local existing = object:FindFirstChildOfClass("UIGradient")
			if existing and existing.Name ~= "ClickShine" then
				return
			end
			table.insert(list, object)
		end
		consider(root)
		for _, object in ipairs(root:GetDescendants()) do
			consider(object)
		end
		return list
	end

	local SweepColor = ColorSequence.new({
		ColorSequenceKeypoint.new(0, Color3.new(1, 1, 1)),
		ColorSequenceKeypoint.new(0.44, Color3.new(1, 1, 1)),
		ColorSequenceKeypoint.new(0.5, Color3.fromRGB(8, 8, 10)),
		ColorSequenceKeypoint.new(0.56, Color3.new(1, 1, 1)),
