	}

	function Library:Notify(options)
		if type(options) ~= "table" then
			options = { Title = tostring(options or "Notification") }
		end
		if self.NotificationsEnabled == false then
			return {
				Dismiss = function() end,
				SetPinned = function() end,
			}
		end
		local delay = tonumber(options.Delay)
		if delay and delay > 0 then
			local pending = { Cancelled = false }
			local shown = nil
			local pinRequest = nil
			local later = table.clone(options)
			later.Delay = nil
			task.delay(delay, function()
				if pending.Cancelled or self.Unloaded then
					return
				end
				shown = self:Notify(later)
				if pinRequest ~= nil then
					shown:SetPinned(pinRequest)
				end
			end)
			function pending:Dismiss()
				if shown then
					shown:Dismiss()
				else
					self.Cancelled = true
				end
			end
			function pending:SetPinned(state)
				if shown then
					shown:SetPinned(state)
				else
					pinRequest = state == true
				end
			end
			return pending
		end
		self:_EnsureGui()
		local title = tostring(options.Title or "Notification")
		local content = options.Content and tostring(options.Content) or ""
		local duration = math.max(tonumber(options.Duration) or 4, 0.5)
		local style = NotifyStyles[options.Type] or NotifyStyles.Info
		local color = Theme[style.Color]
		local iconNames = table.clone(style.Icons)
		if options.Icon then
			table.insert(iconNames, 1, options.Icon)
		end
		self.NotificationOrder += 1

		local wrapper = Create("Frame", {
			Size = UDim2.new(1, 0, 0, 0),
			BackgroundTransparency = 1,
			LayoutOrder = self.NotificationOrder,
			Parent = self.NotificationHolder,
		})
		local slide, fromTop = self:_NotifySlide()
		local animation = self.NotifyAnimation or "Slide"
		local function hiddenOffset(fast)
			local distance = fast and 12 or 24
			if animation == "Fade" or animation == "Pop" then
				return UDim2.fromOffset(0, 0)
			end
			if animation == "Drop" or slide == 0 then
				return UDim2.fromOffset(0, (fromTop and -1 or 1) * math.floor(distance * 0.67))
			end
			return UDim2.fromOffset(distance * slide, 0)
		end
